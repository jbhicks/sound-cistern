package views

templ Analytics(data PageData) {
	@Layout(data) {
		<h1>Listening Analytics</h1>

		<div class="analytics-container">
			<section class="analytics-summary">
				<div class="stat-card">
					<h3>Total Plays</h3>
					<span id="total-plays">-</span>
				</div>
				<div class="stat-card">
					<h3>Hours Listened</h3>
					<span id="hours-listened">-</span>
				</div>
			</section>

			<section class="analytics-section">
				<h2>Top Tracks</h2>
				<ol id="top-tracks" class="analytics-list">
					<li class="loading-placeholder">Loading...</li>
				</ol>
			</section>

			<section class="analytics-section">
				<h2>Top Artists</h2>
				<ol id="top-artists" class="analytics-list">
					<li class="loading-placeholder">Loading...</li>
				</ol>
			</section>

			<section class="analytics-section">
				<h2>Genre Distribution</h2>
				<div id="genre-chart" class="genre-chart">
					<p class="loading-placeholder">Loading...</p>
				</div>
			</section>

			<section class="analytics-section">
				<h2>Recent Plays</h2>
				<ul id="recent-plays" class="analytics-list">
					<li class="loading-placeholder">Loading...</li>
				</ul>
			</section>

			<section class="analytics-actions">
				<button class="secondary" onclick="clearAnalyticsData()">Clear All Data</button>
			</section>
		</div>

		<script src="/js/analytics.js"></script>
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				loadAnalytics();
			});
		</script>
	}
}
