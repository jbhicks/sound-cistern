package views

import (
	"github.com/jbhicks/sound-cistern/views/components"
)

type FavoritesPageData struct {
	PageData
	Favorites     []Track
	ActiveTab     string
	ViewMode      string
	Filters       map[string]interface{}
	IsLoggedIn    string
	MinDuration   int64
	MaxDuration   int64
}

templ FavoritesPage(data FavoritesPageData) {
	@Layout(data.PageData) {
		<main class="container">
			<!-- Vapor Wave Filter Bar -->
			<div class="vapor-filter-bar">
				<div class="vapor-filter-main">
					<div class="vapor-search">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
						<input 
							type="text" 
							name="q"
							id="filter-q"
							placeholder="Search favorites..."
							autocomplete="off"
							hx-get="/api/favorites"
							hx-target="#track-container"
							hx-trigger="input delay:300ms, load"
							hx-include="#filter-content-type,#filter-sort,#filter-limit,#duration-range"
						/>
					</div>
					
					<div class="vapor-filters">
						<select name="content_type" id="filter-content-type" hx-get="/api/favorites" hx-target="#track-container" hx-trigger="change" hx-include="#filter-q,#filter-sort,#filter-limit,#duration-range">
							<option value="">All</option>
							<option value="posts">Posts</option>
							<option value="reposts">Reposts</option>
						</select>
						<select name="sort" id="filter-sort" hx-get="/api/favorites" hx-target="#track-container" hx-trigger="change" hx-include="#filter-q,#filter-content-type,#filter-limit,#duration-range">
							<option value="newest">Newest</option>
							<option value="oldest">Oldest</option>
							<option value="title">Title</option>
							<option value="artist">Artist</option>
							<option value="duration">Duration</option>
						</select>
					</div>
					
					<div class="vapor-actions">
						<select name="limit" id="filter-limit" hx-get="/api/favorites?refresh=true" hx-target="#track-container" hx-trigger="change" hx-include="#duration-range">
							<option value="20">20</option>
							<option value="50">50</option>
							<option value="100">100</option>
						</select>
						<button type="button" class="vapor-btn vapor-btn-clear" onclick="resetFilters()">
							Reset
						</button>
						<div class="export-actions" style="margin-left: 0.5rem;">
							<a href="/api/export/favorites/json" class="vapor-btn" style="background: rgba(139, 92, 246, 0.3); border: 1px solid rgba(139, 92, 246, 0.5);" download="">
								JSON
							</a>
							<a href="/api/export/favorites/csv" class="vapor-btn" style="background: rgba(139, 92, 246, 0.3); border: 1px solid rgba(139, 92, 246, 0.5);" download="">
								CSV
							</a>
						</div>
					</div>
				</div>
				
				<div class="vapor-filter-row">
					<label class="vapor-duration">
						<span>Min Duration: <strong id="duration-min-display">{ formatDurationMinutes(data.MinDuration) }</strong> / { formatDurationMinutes(data.MaxDuration) }</span>
						<input type="range" id="duration-range" min="0" max={ formatInt64(data.MaxDuration) } value={ formatInt64(data.MinDuration) } 
							hx-get="/api/favorites?refresh=true"
							hx-target="#track-container"
							hx-trigger="input delay:300ms, load"
							hx-include="#filter-q,#filter-content-type,#filter-sort,#filter-limit,#duration-range"
							name="duration_min"
							oninput="updateDurationDisplay(this.value)"
						/>
					</label>
				</div>
			</div>

			<div id="loading" aria-busy="true" hidden>
				<small>Loading favorites...</small>
			</div>

		<div id="track-container">
			if len(data.Favorites) > 0 {
				<div class="stream-flip-grid">
					for _, track := range data.Favorites {
						@components.StreamFlipCard(
							track.TrackID,
							track.TrackTitle,
							track.ArtistName,
							track.Genre,
							track.TrackDuration,
							track.ArtworkURL,
							track.PlaybackCount,
							track.FavoritingsCount,
							track.RepostsCount,
						)
					}
				</div>
			} else {
					<article>
						<hgroup>
							<h3>No favorites yet</h3>
							<p>Start exploring your stream and favorite tracks you love.</p>
						</hgroup>
						<footer>
							<a href="/stream" role="button">Go to Stream</a>
						</footer>
					</article>
				}
			</div>

			<div style="text-align: center; margin-top: 1rem;" id="load-more-sentinel">
				<button 
					class="btn btn-secondary load-more-btn"
					id="load-more-btn"
					data-page="2"
					data-loaded="0"
					hx-get="/api/favorites"
					hx-vals='{"page":"2"}'
					hx-include="#filter-q,#filter-content-type,#filter-sort,#filter-limit,#duration-range"
					hx-target="#track-container"
					hx-swap="beforeend"
					hx-trigger="revealed"
					hx-indicator="#load-more-indicator"
					hx-on::after-request="handleLoadMore(this, event)"
					aria-label="Load more favorites"
				>
					Load More
				</button>
				<span id="load-more-indicator" class="htmx-indicator" aria-busy="true" hidden>
					<small>Loading more...</small>
				</span>
				<small id="no-more" hidden>All favorites loaded</small>
			</div>
		</main>

		<div id="player-container"></div>

		<script>
			// Initialize filter state on page load
			(function() {
				loadFilterState();
				setupFilterListeners();
				
				// Enhance all artwork to highest quality
				document.querySelectorAll('.stream-flip-card img').forEach(function(img) {
					img.src = upgradeArtwork(img.src);
				});
				
				// Initialize loaded count from initial tracks
				const loadMoreBtn = document.getElementById('load-more-btn');
				const trackContainer = document.getElementById('track-container');
				if (loadMoreBtn && trackContainer) {
					const initialTracks = trackContainer.querySelectorAll('.stream-flip-card, .track-card-pill').length;
					loadMoreBtn.setAttribute('data-loaded', initialTracks);
					
					const limit = parseInt(document.getElementById('filter-limit')?.value) || 20;
					if (initialTracks >= limit) {
						loadMoreBtn.hidden = true;
						document.getElementById('no-more').hidden = false;
					}
				}
			})();
		</script>
	}
}
