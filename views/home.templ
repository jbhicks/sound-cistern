package views

templ Home(data PageData) {
	@Layout(data) {
		<section class="hero-section">
			<hgroup>
				<h1>Welcome to Sound Cistern</h1>
				<p>Your Soundcloud feed aggregator</p>
			</hgroup>
			<p>
				Sound Cistern helps you aggregate and manage your Soundcloud feeds in one place.
				Connect your Soundcloud account to get started.
			</p>
			if data.User != nil {
				<a href="/dashboard" role="button">Go to Dashboard</a>
			} else {
				<a href="/signup" role="button">Get Started</a>
				<a href="/signin" role="button" class="secondary">Sign In</a>
			}
		</section>
	}
}
