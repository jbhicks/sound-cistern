package views

type ProtoData struct {
	PageData
	Tracks []Track
}

templ Proto(data ProtoData) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Waveform Player Prototypes - Sound Cistern</title>
			<link rel="stylesheet" href="/css/pico.min.css"/>
			<link rel="stylesheet" href="/css/custom.css"/>
			<script src="/js/htmx.min.js"></script>
			<style>
			.wf-player-section {
				margin-bottom: 3rem;
				background: linear-gradient(to bottom, #1a1a1a, #0d0d0d);
				border-radius: 16px;
				padding: 1.5rem;
				border: 1px solid rgba(139, 92, 246, 0.2);
			}
			.wf-player-title {
				color: #a78bfa;
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 1rem;
			}
			.wf-player-bar {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				background: linear-gradient(to top, #1a1a1a, #2d2d2d);
				border-top: 1px solid rgba(139, 92, 246, 0.3);
				padding: 0.75rem 1rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				z-index: 1000;
				transform: translateY(100%);
				transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
			}
			.wf-player-bar.wf-active {
				transform: translateY(0);
			}
			.wf-player-art {
				width: 48px;
				height: 48px;
				border-radius: 8px;
				object-fit: cover;
				box-shadow: 0 2px 8px rgba(0,0,0,0.3);
			}
			.wf-player-info {
				flex: 0 0 140px;
				overflow: hidden;
			}
			.wf-player-track-title {
				font-weight: 600;
				font-size: 0.85rem;
				color: #fff;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.wf-player-artist {
				font-size: 0.75rem;
				color: rgba(255,255,255,0.7);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.wf-player-controls {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.wf-player-btn {
				background: none;
				border: none;
				color: #fff;
				cursor: pointer;
				padding: 0.5rem;
				border-radius: 50%;
				transition: background 0.2s;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.wf-player-btn:hover {
				background: rgba(255,255,255,0.1);
			}
			.wf-player-btn--play {
				background: #8b5cf6;
				width: 40px;
				height: 40px;
			}
			.wf-player-btn--play:hover {
				background: #7c3aed;
			}

			.wf-waveform-container {
				position: relative;
				height: 40px;
				cursor: pointer;
				border-radius: 4px;
				overflow: hidden;
			}
			.wf-waveform-img {
				width: 100%;
				height: 100%;
				object-fit: fill;
				display: block;
			}
			.wf-waveform-wrapper {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				min-width: 0;
			}

			.wf-overlay-progress {
				position: absolute;
				top: 0;
				left: 0;
				height: 100%;
				width: 0%;
				background: rgba(139, 92, 246, 0.4);
				pointer-events: none;
				border-right: 2px solid #8b5cf6;
			}
			.wf-overlay-progress::after {
				content: '';
				position: absolute;
				right: -4px;
				top: 50%;
				transform: translateY(-50%);
				width: 8px;
				height: 8px;
				background: #fff;
				border-radius: 50%;
				box-shadow: 0 0 10px rgba(139, 92, 246, 0.8);
			}

			.wf-scan-line {
				position: absolute;
				top: 0;
				left: 0%;
				height: 100%;
				width: 2px;
				background: #fff;
				box-shadow: 0 0 15px 5px rgba(139, 92, 246, 0.9);
				pointer-events: none;
			}
			.wf-scan-line::before {
				content: '';
				position: absolute;
				top: -4px;
				left: 50%;
				transform: translateX(-50%);
				width: 0;
				height: 0;
				border-left: 6px solid transparent;
				border-right: 6px solid transparent;
				border-top: 6px solid #fff;
			}
			.wf-scan-line::after {
				content: '';
				position: absolute;
				bottom: -4px;
				left: 50%;
				transform: translateX(-50%);
				width: 0;
				height: 0;
				border-left: 6px solid transparent;
				border-right: 6px solid transparent;
				border-bottom: 6px solid #fff;
			}

			.wf-two-tone-container {
				position: relative;
				width: 100%;
				height: 100%;
			}
			.wf-waveform-unplayed {
				position: absolute;
				inset: 0;
				filter: brightness(0.4) saturate(0.5);
			}
			.wf-waveform-played {
				position: absolute;
				top: 0;
				left: 0;
				height: 100%;
				width: 0%;
				overflow: hidden;
			}
			.wf-waveform-played img {
				height: 100%;
				width: auto;
				min-width: 100%;
				object-fit: fill;
				filter: sepia(1) hue-rotate(200deg) saturate(2);
			}

			.wf-time-row {
				display: flex;
				justify-content: space-between;
				font-size: 0.7rem;
				color: rgba(255,255,255,0.6);
				margin-top: 0.25rem;
				padding: 0 0.25rem;
			}

			.wf-player-close {
				background: none;
				border: none;
				color: rgba(255,255,255,0.6);
				cursor: pointer;
				padding: 0.5rem;
				border-radius: 50%;
				transition: all 0.2s;
			}
			.wf-player-close:hover {
				color: #fff;
				background: rgba(255,255,255,0.1);
			}

			.wf-proto-card {
				background: rgba(255,255,255,0.05);
				border-radius: 12px;
				padding: 1rem;
				cursor: pointer;
				transition: all 0.2s;
				border: 2px solid transparent;
			}
			.wf-proto-card:hover {
				background: rgba(255,255,255,0.1);
				border-color: rgba(139, 92, 246, 0.3);
			}
			.wf-proto-card.wf-selected {
				border-color: #8b5cf6;
				background: rgba(139, 92, 246, 0.1);
			}
			.wf-proto-name {
				font-weight: 600;
				color: #fff;
				margin-bottom: 0.25rem;
			}
			.wf-proto-desc {
				font-size: 0.8rem;
				color: rgba(255,255,255,0.6);
			}
			</style>
		</head>
		<body class="container">
			<nav>
				<ul>
					<li><strong>Waveform Player Prototypes</strong></li>
				</ul>
				<ul>
					<li><a href="/stream">← Back to App</a></li>
				</ul>
			</nav>

			<hgroup>
				<h1>Waveform Player Prototypes</h1>
				<p>Click anywhere on the waveform to seek. Progress shown with visual overlay.</p>
			</hgroup>

			if len(data.Tracks) == 0 {
				<p>No tracks available. Sync from SoundCloud to get tracks.</p>
			} else {
				<div class="wf-player-section">
					<div class="wf-player-title">Test Track: { data.Tracks[0].TrackTitle } by { data.Tracks[0].ArtistName }</div>
					
					<div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
						<div class="wf-proto-card wf-selected" data-proto="a" onclick="selectWaveformProto('a')">
							<div class="wf-proto-name">A. Overlay Progress</div>
							<div class="wf-proto-desc">Purple overlay with playhead marker</div>
						</div>
						<div class="wf-proto-card" data-proto="b" onclick="selectWaveformProto('b')">
							<div class="wf-proto-name">B. Scanning Line</div>
							<div class="wf-proto-desc">Glowing vertical line with arrows</div>
						</div>
						<div class="wf-proto-card" data-proto="c" onclick="selectWaveformProto('c')">
							<div class="wf-proto-name">C. Two-Tone</div>
							<div class="wf-proto-desc">Played portion colored purple (requires real waveform image)</div>
						</div>
					</div>

					<button 
						class="wf-player-btn wf-player-btn--play" 
						id="wf-launch-btn"
						data-track-id={ data.Tracks[0].TrackID }
						data-stream-url="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"
						data-title={ data.Tracks[0].TrackTitle }
						data-artist={ data.Tracks[0].ArtistName }
						data-artwork={ data.Tracks[0].ArtworkURL }
						data-waveform={ data.Tracks[0].WaveformURL }
						onclick="launchWaveformPlayer(this)"
						style="width: auto; padding: 0.75rem 1.5rem; border-radius: 8px;">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.5rem;"><path d="M8 5v14l11-7z"/></svg>
						Launch Waveform Player
					</button>
				</div>
			}

			<div id="wf-player-bar" class="wf-player-bar">
				<img id="wf-player-art" src="" alt="" class="wf-player-art"/>
				<div class="wf-player-info">
					<div id="wf-player-title" class="wf-player-track-title"></div>
					<div id="wf-player-artist" class="wf-player-artist"></div>
				</div>
				<div class="wf-player-controls">
					<button class="wf-player-btn wf-player-btn--play" id="wf-player-play" aria-label="Play/Pause">
						<svg id="wf-play-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
						<svg id="wf-pause-icon" style="display: none;" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
					</button>
				</div>

				<div class="wf-waveform-wrapper">
					<div id="wf-waveform-a" class="wf-waveform-container" style="display: none;" onclick="seekWaveformA(event)">
						<img id="wf-wave-img-a" src="" alt="Waveform" class="wf-waveform-img"/>
						<div id="wf-overlay-progress" class="wf-overlay-progress"></div>
					</div>

					<div id="wf-waveform-b" class="wf-waveform-container" style="display: none;" onclick="seekWaveformB(event)">
						<img id="wf-wave-img-b" src="" alt="Waveform" class="wf-waveform-img"/>
						<div id="wf-scan-line" class="wf-scan-line"></div>
					</div>

					<div id="wf-waveform-c" class="wf-waveform-container" style="display: none;" onclick="seekWaveformC(event)">
						<div class="wf-two-tone-container">
							<img id="wf-wave-img-c-unplayed" src="" alt="Waveform" class="wf-waveform-img wf-waveform-unplayed"/>
							<div id="wf-waveform-played" class="wf-waveform-played">
								<img id="wf-wave-img-c-played" src="" alt="Waveform"/>
							</div>
						</div>
					</div>

					<div class="wf-time-row" id="wf-time-row">
						<span id="wf-current-time">0:00</span>
						<span id="wf-duration">0:00</span>
					</div>
				</div>

				<button class="wf-player-close" id="wf-player-close" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
				</button>
				<audio id="wf-audio" preload="metadata"></audio>
			</div>

			<script>
			let currentWaveformProto = 'a';
			let wfAudio = null;
			let wfWaveformURL = '';

			function selectWaveformProto(proto) {
				currentWaveformProto = proto;
				document.querySelectorAll('.wf-proto-card').forEach(card => {
					card.classList.toggle('wf-selected', card.dataset.proto === proto);
				});
				
				document.getElementById('wf-waveform-a').style.display = 'none';
				document.getElementById('wf-waveform-b').style.display = 'none';
				document.getElementById('wf-waveform-c').style.display = 'none';
				
				if (document.getElementById('wf-player-bar').classList.contains('wf-active')) {
					document.getElementById('wf-waveform-' + proto).style.display = 'block';
				}
			}

			function launchWaveformPlayer(btn) {
				const trackID = btn.dataset.trackId;
				const streamURL = btn.dataset.streamUrl;
				const title = btn.dataset.title;
				const artist = btn.dataset.artist;
				const artworkURL = btn.dataset.artwork;
				const waveformURL = btn.dataset.waveform;
				startWaveformPlayer(trackID, streamURL, title, artist, artworkURL, waveformURL);
			}

			function startWaveformPlayer(trackID, streamURL, title, artist, artworkURL, waveformURL) {
				// Use placeholder with a simple pattern, or the real waveform
				const fallbackWaveform = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 40'%3E" +
					"%3Crect fill='%23222' width='1000' height='40'/%3E" +
					"%3Cpath d='M0,20 Q50,5 100,20 T200,20 T300,20 T400,20 T500,20 T600,20 T700,20 T800,20 T900,20 T1000,20' " +
					"stroke='%23666' stroke-width='2' fill='none'/%3E%3C/svg%3E";
				wfWaveformURL = waveformURL || fallbackWaveform;
				wfAudio = document.getElementById('wf-audio');
				
				const player = document.getElementById('wf-player-bar');
				document.getElementById('wf-player-art').src = artworkURL;
				document.getElementById('wf-player-title').textContent = title;
				document.getElementById('wf-player-artist').textContent = artist;
				
				document.getElementById('wf-wave-img-a').src = wfWaveformURL;
				document.getElementById('wf-wave-img-b').src = wfWaveformURL;
				document.getElementById('wf-wave-img-c-unplayed').src = wfWaveformURL;
				document.getElementById('wf-wave-img-c-played').src = wfWaveformURL;
				
				document.getElementById('wf-overlay-progress').style.width = '0%';
				document.getElementById('wf-scan-line').style.left = '0%';
				document.getElementById('wf-waveform-played').style.width = '0%';
				document.getElementById('wf-current-time').textContent = '0:00';
				document.getElementById('wf-duration').textContent = 'Loading...';
				
				document.getElementById('wf-waveform-a').style.display = currentWaveformProto === 'a' ? 'block' : 'none';
				document.getElementById('wf-waveform-b').style.display = currentWaveformProto === 'b' ? 'block' : 'none';
				document.getElementById('wf-waveform-c').style.display = currentWaveformProto === 'c' ? 'block' : 'none';
				
				wfAudio.src = streamURL;
				player.classList.add('wf-active');
				
				wfAudio.play().then(() => {
					document.getElementById('wf-play-icon').style.display = 'none';
					document.getElementById('wf-pause-icon').style.display = 'block';
				}).catch(err => console.error('Play error:', err));
			}

			document.getElementById('wf-player-play')?.addEventListener('click', function() {
				if (!wfAudio) wfAudio = document.getElementById('wf-audio');
				const playIcon = document.getElementById('wf-play-icon');
				const pauseIcon = document.getElementById('wf-pause-icon');
				
				if (wfAudio.paused) {
					wfAudio.play();
					playIcon.style.display = 'none';
					pauseIcon.style.display = 'block';
				} else {
					wfAudio.pause();
					playIcon.style.display = 'block';
					pauseIcon.style.display = 'none';
				}
			});

			document.getElementById('wf-player-close')?.addEventListener('click', function() {
				const player = document.getElementById('wf-player-bar');
				if (wfAudio) wfAudio.pause();
				player.classList.remove('wf-active');
			});

			document.getElementById('wf-audio')?.addEventListener('timeupdate', function() {
				const audio = document.getElementById('wf-audio');
				if (!audio.duration) return;
				const percent = (audio.currentTime / audio.duration) * 100;
				
				document.getElementById('wf-overlay-progress').style.width = percent + '%';
				document.getElementById('wf-scan-line').style.left = percent + '%';
				document.getElementById('wf-waveform-played').style.width = percent + '%';
				
				document.getElementById('wf-current-time').textContent = formatWaveTime(audio.currentTime);
				document.getElementById('wf-duration').textContent = formatWaveTime(audio.duration);
			});

			document.getElementById('wf-audio')?.addEventListener('loadedmetadata', function() {
				const audio = document.getElementById('wf-audio');
				document.getElementById('wf-duration').textContent = formatWaveTime(audio.duration);
				document.getElementById('wf-current-time').textContent = '0:00';
			});

			document.getElementById('wf-audio')?.addEventListener('ended', function() {
				document.getElementById('wf-play-icon').style.display = 'block';
				document.getElementById('wf-pause-icon').style.display = 'none';
				document.getElementById('wf-overlay-progress').style.width = '0%';
				document.getElementById('wf-scan-line').style.left = '0%';
				document.getElementById('wf-waveform-played').style.width = '0%';
				document.getElementById('wf-current-time').textContent = '0:00';
			});

			function formatWaveTime(seconds) {
				if (!seconds || isNaN(seconds)) return '0:00';
				const mins = Math.floor(seconds / 60);
				const secs = Math.floor(seconds % 60);
				return mins + ':' + secs.toString().padStart(2, '0');
			}

			function seekWaveformA(e) { seekWaveform(e, 'wf-waveform-a'); }
			function seekWaveformB(e) { seekWaveform(e, 'wf-waveform-b'); }
			function seekWaveformC(e) { seekWaveform(e, 'wf-waveform-c'); }

			function seekWaveform(e, containerId) {
				if (!wfAudio || !wfAudio.duration) return;
				const container = document.getElementById(containerId);
				const rect = container.getBoundingClientRect();
				const pos = (e.clientX - rect.left) / rect.width;
				wfAudio.currentTime = pos * wfAudio.duration;
			}
			</script>
		</body>
	</html>
}
