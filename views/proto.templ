package views

type ProtoData struct {
	PageData
	Tracks []Track
}

templ Proto(data ProtoData) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Track Card Prototypes - Sound Cistern</title>
			<link rel="stylesheet" href="/css/pico.min.css"/>
		<link rel="stylesheet" href="/css/custom.css"/>
			<script src="/js/htmx.min.js"></script>
			<style>
			/* Proto card container */
			.proto-card { min-width: 300px; background: var(--pico-background-color); border-radius: 16px; overflow: hidden; }
			.proto-title { padding: 1rem 1rem 0.25rem; font-size: 1rem; font-weight: 600; margin: 0; }
			.proto-desc { padding: 0 1rem 1rem; color: var(--pico-muted-color); font-size: 0.85rem; margin: 0; }
			
			/* Shared image styles */
			.proto-img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
			
			/* HOVER PLAY BUTTON shared */
			.proto-hover { position: relative; cursor: pointer; }
			.proto-hover-play { 
				position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.85); 
				width: 72px; height: 72px; border-radius: 50%; background: #fff; border: none; cursor: pointer; 
				display: flex; align-items: center; justify-content: center; 
				opacity: 0; transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); 
				box-shadow: 0 8px 32px rgba(0,0,0,0.4); 
				z-index: 10;
			}
			.proto-hover:hover .proto-hover-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
			.proto-hover-info { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem 1rem 1rem; background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); color: #fff; z-index: 5; }
			.proto-hover-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem; text-shadow: 0 2px 8px rgba(0,0,0,0.5); }
			.proto-hover-artist { font-size: 0.9rem; opacity: 0.85; }
			.proto-hover-stats { display: flex; gap: 0.75rem; margin-top: 0.5rem; font-size: 0.8rem; opacity: 0.9; }
			
			/* Purple Neon - single color variant */
			
			/* SEMANTIC COLORS for stat icons */
			.stat-plays { background: linear-gradient(135deg, #10b981, #34d399) !important; color: #fff !important; }
			.stat-likes { background: linear-gradient(135deg, #ec4899, #f472b6) !important; color: #fff !important; }
			.stat-reposts { background: linear-gradient(135deg, #f97316, #fb923c) !important; color: #fff !important; }
			.stat-duration { background: linear-gradient(135deg, #3b82f6, #60a5fa) !important; color: #fff !important; }
			
			/* Full stats with labels */
			.proto-hover-stats-full { display: flex; gap: 0.75rem; margin-top: 0.5rem; flex-wrap: wrap; }
			.proto-hover-stats-full span { display: flex; align-items: center; gap: 0.25rem; padding: 0.15rem 0.5rem; border-radius: 12px; font-size: 0.75rem; }
			.proto-hover-stats-full .stat-value { font-weight: 700; }
			.proto-hover-stats-full .stat-label { font-weight: 400; opacity: 0.85; }
			.proto-hover-meta { display: flex; gap: 0.75rem; margin-top: 0.4rem; font-size: 0.75rem; opacity: 0.9; }
			.proto-hover-meta span { display: flex; align-items: center; gap: 0.25rem; }
			.meta-genre { color: #a78bfa; }
			.meta-duration { color: #60a5fa; }
			
			/* Genre tag */
			.proto-hover-genre { font-size: 0.7rem; margin-top: 0.4rem; opacity: 0.85; color: #c4b5fd; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
			
			/* Corner badges */
			.proto-corner-badges { position: relative; }
			.corner-badge { position: absolute; padding: 0.25rem 0.5rem; border-radius: 8px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; }
			.corner-genre { top: 8px; left: 8px; background: rgba(139, 92, 246, 0.9); color: #fff; }
			.corner-duration { top: 8px; right: 8px; background: rgba(59, 130, 246, 0.9); color: #fff; }
			
			/* Compact stats - shorter pills */
			.proto-hover-stats-compact { display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
			.proto-hover-stats-compact span { padding: 0.15rem 0.4rem; border-radius: 10px; font-size: 0.7rem; font-weight: 600; white-space: nowrap; }
			
			/* Combined Flip Card Styles */
			.combined-flip-container { perspective: 1000px; cursor: pointer; width: 300px; }
			.combined-flip { position: relative; width: 100%; aspect-ratio: 1; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1); }
			.combined-flip.flipped { transform: rotateY(180deg); }
			.combined-flip-front, .combined-flip-back { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 12px; overflow: hidden; }
			.combined-flip-front { background: #1a1a1a; }
			.combined-flip-front img { width: 100%; height: 100%; object-fit: cover; }
			.combined-flip-back { transform: rotateY(180deg); background: #0d0d0d; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
			.combined-flip-vinyl { width: 90%; height: 90%; border-radius: 50%; position: relative; animation: vinylSpin 1.8s linear infinite; background: 
				repeating-radial-gradient(circle at center, transparent 0px, transparent 3px, rgba(40,40,40,0.9) 3px, rgba(40,40,40,0.9) 4px),
				radial-gradient(circle at center, #1a1a1a 35%, #0a0a0a 100%); box-shadow: 0 0 30px rgba(0,0,0,0.5), inset 0 0 50px rgba(0,0,0,0.3); }
			.combined-flip-vinyl::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 38%; height: 38%; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6, #a78bfa); box-shadow: 0 0 20px rgba(139, 92, 246, 0.5); }
			.combined-flip-vinyl::after { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 50%; background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%, transparent 100%); }
			.combined-flip-label { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32%; height: 32%; border-radius: 50%; overflow: hidden; }
			.combined-flip-label img { width: 100%; height: 100%; object-fit: cover; }
			.combined-flip-front-info { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem 1rem 1rem; background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); color: #fff; }
			.combined-flip-front-info .proto-hover-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem; text-shadow: 0 2px 8px rgba(0,0,0,0.5); }
			.combined-flip-front-info .proto-hover-artist { font-size: 0.9rem; opacity: 0.85; }
			.combined-flip-front-info .proto-hover-stats { display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
			.combined-flip-front-info .proto-hover-stats span { padding: 0.15rem 0.4rem; border-radius: 10px; font-size: 0.7rem; font-weight: 600; white-space: nowrap; }
			.combined-flip-front-info .proto-hover-genre { font-size: 0.7rem; margin-top: 0.4rem; opacity: 0.85; color: #c4b5fd; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
			
			/* Global Audio Player */
			.global-audio-player {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				background: linear-gradient(to top, #1a1a1a, #2d2d2d);
				border-top: 1px solid rgba(139, 92, 246, 0.3);
				padding: 0.75rem 1rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				z-index: 1000;
				transform: translateY(100%);
				transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
			}
			.global-audio-player.player-active, .global-audio-player.active {
				transform: translateY(0);
			}
			.global-player-art {
				width: 48px;
				height: 48px;
				border-radius: 8px;
				object-fit: cover;
				box-shadow: 0 2px 8px rgba(0,0,0,0.3);
			}
			.global-player-info {
				flex: 0 0 150px;
				overflow: hidden;
			}
			.global-player-title {
				font-weight: 600;
				font-size: 0.9rem;
				color: #fff;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.global-player-artist {
				font-size: 0.75rem;
				color: rgba(255,255,255,0.7);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.global-player-controls {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.global-player-btn {
				background: none;
				border: none;
				color: #fff;
				cursor: pointer;
				padding: 0.5rem;
				border-radius: 50%;
				transition: background 0.2s;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.global-player-btn:hover {
				background: rgba(255,255,255,0.1);
			}
			.global-player-btn--play {
				background: #8b5cf6;
				width: 40px;
				height: 40px;
			}
			.global-player-btn--play:hover {
				background: #7c3aed;
			}
			.global-player-progress {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.global-player-bar {
				height: 6px;
				background: rgba(255,255,255,0.2);
				border-radius: 3px;
				cursor: pointer;
				overflow: hidden;
			}
			.global-player-fill {
				height: 100%;
				background: linear-gradient(90deg, #8b5cf6, #a78bfa);
				border-radius: 3px;
				width: 0%;
				transition: width 0.1s linear;
			}
			.global-player-time {
				display: flex;
				justify-content: space-between;
				font-size: 0.7rem;
				color: rgba(255,255,255,0.6);
			}
			.global-player-close {
				background: none;
				border: none;
				color: rgba(255,255,255,0.6);
				cursor: pointer;
				padding: 0.5rem;
				border-radius: 50%;
				transition: all 0.2s;
			}
			.global-player-close:hover {
				color: #fff;
				background: rgba(255,255,255,0.1);
			}
			</style>
		</head>
		<body class="container">
			<nav>
				<ul>
					<li><strong>Prototypes</strong></li>
				</ul>
				<ul>
					<li><a href="/stream">← Back to App</a></li>
				</ul>
			</nav>

			<hgroup>
				<h1>Track Card Prototypes</h1>
				<p>Purple Neon variations - hover to see play button</p>
			</hgroup>

			if len(data.Tracks) == 0 {
				<p>No tracks available. Sync from SoundCloud to get tracks.</p>
			} else {
				<!-- Horizontal scrolling container -->
				<div style="display: flex; gap: 1.5rem; overflow-x: auto; padding: 1rem;">
				
				<!-- Purple Neon - various layouts to fit more data -->
			<!-- Using Track data - stream will be fetched via /api/track/:id/stream (gets highest quality) -->
			
			<!-- VARIATION 1: Compact with all stats -->
			<article class="proto-card proto-purple">
				<h3 class="proto-title">1. Compact - All Stats</h3>
				<p class="proto-desc">Genre • Duration • All counts</p>
				<article data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName } class="proto-hover proto-purple">
					<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle } class="proto-img"/>
					<button aria-label="Play" class="proto-hover-play" data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName }>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"></path></svg>
					</button>
					<div class="proto-hover-info">
						<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
						<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
						<div class="proto-hover-stats">
							<span class="stat-plays">▶ { formatCount(data.Tracks[0].PlaybackCount) }</span>
							<span class="stat-likes">♡ { formatCount(data.Tracks[0].FavoritingsCount) }</span>
							<span class="stat-reposts">↻ { formatCount(data.Tracks[0].RepostsCount) }</span>
							<span class="stat-duration">{ formatDuration(data.Tracks[0].TrackDuration) }</span>
						</div>
						<div class="proto-hover-genre">{ data.Tracks[0].Genre }</div>
					</div>
				</article>
			</article>

			<!-- VARIATION 2: Two-row stats -->
			<article class="proto-card proto-purple">
				<h3 class="proto-title">2. Two Rows</h3>
				<p class="proto-desc">Stats above, genre below</p>
				<article data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName } class="proto-hover proto-purple">
					<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle } class="proto-img"/>
					<button aria-label="Play" class="proto-hover-play" data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName }>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"></path></svg>
					</button>
					<div class="proto-hover-info">
						<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
						<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
						<div class="proto-hover-stats">
							<span class="stat-plays">▶ { formatCount(data.Tracks[0].PlaybackCount) }</span>
							<span class="stat-likes">♡ { formatCount(data.Tracks[0].FavoritingsCount) }</span>
							<span class="stat-reposts">↻ { formatCount(data.Tracks[0].RepostsCount) }</span>
						</div>
						<div class="proto-hover-genre">{ data.Tracks[0].Genre } • { formatDuration(data.Tracks[0].TrackDuration) }</div>
					</div>
				</article>
			</article>

			<!-- VARIATION 3: Stats in corners -->
			<article class="proto-card proto-purple">
				<h3 class="proto-title">3. Corner Badges</h3>
				<p class="proto-desc">Genre top-left, duration top-right</p>
				<article data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName } class="proto-hover proto-purple proto-corner-badges">
					<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle } class="proto-img"/>
					<button aria-label="Play" class="proto-hover-play" data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName }>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"></path></svg>
					</button>
					<div class="proto-hover-info">
						<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
						<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
						<div class="proto-hover-stats">
							<span class="stat-plays">▶ { formatCount(data.Tracks[0].PlaybackCount) }</span>
							<span class="stat-likes">♡ { formatCount(data.Tracks[0].FavoritingsCount) }</span>
							<span class="stat-reposts">↻ { formatCount(data.Tracks[0].RepostsCount) }</span>
						</div>
					</div>
					<div class="corner-badge corner-genre">{ data.Tracks[0].Genre }</div>
					<div class="corner-badge corner-duration">{ formatDuration(data.Tracks[0].TrackDuration) }</div>
				</article>
			</article>

			<!-- VARIATION 4: Minimal compact -->
			<article class="proto-card proto-purple">
				<h3 class="proto-title">4. Minimal</h3>
				<p class="proto-desc">Just essentials, small pills</p>
				<article data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName } class="proto-hover proto-purple">
					<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle } class="proto-img"/>
					<button aria-label="Play" class="proto-hover-play" data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName }>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"></path></svg>
					</button>
					<div class="proto-hover-info">
						<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
						<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
						<div class="proto-hover-genre">{ data.Tracks[0].Genre }</div>
					</div>
				</article>
			</article>

			<!-- VARIATION 5: Full info compact -->
			<article class="proto-card proto-purple">
				<h3 class="proto-title">5. Full Info Compact</h3>
				<p class="proto-desc">Short pills + genre</p>
				<article data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName } class="proto-hover proto-purple">
					<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle } class="proto-img"/>
					<button aria-label="Play" class="proto-hover-play" data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName }>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"></path></svg>
					</button>
					<div class="proto-hover-info">
						<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
						<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
						<div class="proto-hover-stats-compact">
							<span class="stat-plays">▶ { formatCount(data.Tracks[0].PlaybackCount) }</span>
							<span class="stat-likes">♡ { formatCount(data.Tracks[0].FavoritingsCount) }</span>
							<span class="stat-reposts">↻ { formatCount(data.Tracks[0].RepostsCount) }</span>
							<span class="stat-duration">⏱ { formatDuration(data.Tracks[0].TrackDuration) }</span>
						</div>
						<div class="proto-hover-meta">
							<span class="meta-genre">🎵 { data.Tracks[0].Genre }</span>
						</div>
					</div>
				</article>
				</article>

			<!-- VARIATION 5: Full info compact -->
			<article class="proto-card proto-purple">
				<h3 class="proto-title">5. Full Info Compact</h3>
				<p class="proto-desc">Short pills + genre</p>
				<article data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName } class="proto-hover proto-purple">
					<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle } class="proto-img"/>
					<button aria-label="Play" class="proto-hover-play" data-track-id={ data.Tracks[0].TrackID } data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" } data-track-title={ data.Tracks[0].TrackTitle } data-artist-name={ data.Tracks[0].ArtistName }>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"></path></svg>
					</button>
					<div class="proto-hover-info">
						<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
						<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
						<div class="proto-hover-stats-compact">
							<span class="stat-plays">▶ { formatCount(data.Tracks[0].PlaybackCount) }</span>
							<span class="stat-likes">♡ { formatCount(data.Tracks[0].FavoritingsCount) }</span>
							<span class="stat-reposts">↻ { formatCount(data.Tracks[0].RepostsCount) }</span>
							<span class="stat-duration">⏱ { formatDuration(data.Tracks[0].TrackDuration) }</span>
						</div>
						<div class="proto-hover-meta">
							<span class="meta-genre">🎵 { data.Tracks[0].Genre }</span>
						</div>
					</div>
				</article>
			</article>

			<!-- Your Latest Tracks with Combined Flip Card -->
			<article class="proto-card" style="flex: 0 0 auto;">
				<h3 class="proto-title">Your Latest Tracks</h3>
				<p class="proto-desc">Click to flip & play</p>
				<div class="combined-flip-container" 
					data-track-id={ data.Tracks[0].TrackID } 
					data-stream-url={ "/api/track/" + data.Tracks[0].TrackID + "/stream" }
					data-track-title={ data.Tracks[0].TrackTitle }
					data-artist-name={ data.Tracks[0].ArtistName }
					onclick="handleCombinedFlip(this)">
					<div class="combined-flip">
						<div class="combined-flip-front">
							<img src={ data.Tracks[0].ArtworkURL } alt={ data.Tracks[0].TrackTitle }/>
							<div class="combined-flip-front-info">
								<div class="proto-hover-title">{ data.Tracks[0].TrackTitle }</div>
								<div class="proto-hover-artist">{ data.Tracks[0].ArtistName }</div>
								<div class="proto-hover-stats">
									<span class="stat-plays">▶ { formatCount(data.Tracks[0].PlaybackCount) }</span>
									<span class="stat-likes">♡ { formatCount(data.Tracks[0].FavoritingsCount) }</span>
									<span class="stat-reposts">↻ { formatCount(data.Tracks[0].RepostsCount) }</span>
									<span class="stat-duration">{ formatDuration(data.Tracks[0].TrackDuration) }</span>
								</div>
								<div class="proto-hover-genre">{ data.Tracks[0].Genre }</div>
							</div>
						</div>
						<div class="combined-flip-back">
							<div class="combined-flip-vinyl">
								<div class="combined-flip-label">
									<img src={ data.Tracks[0].ArtworkURL } alt=""/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>

			<!-- Show more tracks with the same card -->
			for i, track := range data.Tracks {
				if i == 0 {
					continue
				}
			<article class="proto-card" style="flex: 0 0 auto;">
				<div class="combined-flip-container" 
					data-track-id={ track.TrackID } 
					data-stream-url={ "/api/track/" + track.TrackID + "/stream" }
					data-track-title={ track.TrackTitle }
					data-artist-name={ track.ArtistName }
					onclick="handleCombinedFlip(this)">
					<div class="combined-flip">
						<div class="combined-flip-front">
							<img src={ track.ArtworkURL } alt={ track.TrackTitle }/>
							<div class="combined-flip-front-info">
								<div class="proto-hover-title">{ track.TrackTitle }</div>
								<div class="proto-hover-artist">{ track.ArtistName }</div>
								<div class="proto-hover-stats">
									<span class="stat-plays">▶ { formatCount(track.PlaybackCount) }</span>
									<span class="stat-likes">♡ { formatCount(track.FavoritingsCount) }</span>
									<span class="stat-reposts">↻ { formatCount(track.RepostsCount) }</span>
									<span class="stat-duration">{ formatDuration(track.TrackDuration) }</span>
								</div>
								<div class="proto-hover-genre">{ track.Genre }</div>
							</div>
						</div>
						<div class="combined-flip-back">
							<div class="combined-flip-vinyl">
								<div class="combined-flip-label">
									<img src={ track.ArtworkURL } alt=""/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>
			}

				</div>
			}

		<!-- =============================================================================
		     HEADER + FILTER PROTOTYPES
		     5 Header themes with complementary filter bars
		     ============================================================================ -->

		<hgroup style="margin-top: 3rem;">
			<h2>Header & Filter Prototypes</h2>
			<p>5 beautiful header themes with complementary filter control bars</p>
		</hgroup>

		<!-- THEME 1: Midnight Aurora - Deep purples with aurora gradients -->
		<div style="margin-bottom: 3rem;">
			<header class="proto-header-aurora">
				<div class="aurora-bg"></div>
				<div class="aurora-content">
					<h1>Your Stream</h1>
					<p class="aurora-subtitle">Discover new music from your network</p>
				</div>
			</header>
			<style>
				.proto-header-aurora {
					position: relative;
					padding: 3rem 2rem;
					border-radius: 16px 16px 0 0;
					overflow: hidden;
					min-height: 140px;
				}
				.aurora-bg {
					position: absolute;
					inset: 0;
					background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
				}
				.aurora-bg::before {
					content: '';
					position: absolute;
					inset: 0;
					background: 
						radial-gradient(ellipse at 20% 80%, rgba(139, 92, 246, 0.4) 0%, transparent 50%),
						radial-gradient(ellipse at 80% 20%, rgba(59, 130, 246, 0.3) 0%, transparent 50%),
						radial-gradient(ellipse at 50% 50%, rgba(236, 72, 153, 0.2) 0%, transparent 60%);
					animation: auroraPulse 8s ease-in-out infinite;
				}
				@keyframes auroraPulse {
					0%, 100% { opacity: 0.6; }
					50% { opacity: 1; }
				}
				.aurora-content {
					position: relative;
					z-index: 1;
				}
				.proto-header-aurora h1 {
					color: #fff;
					margin: 0;
					font-size: 2.5rem;
					font-weight: 700;
					text-shadow: 0 2px 20px rgba(139, 92, 246, 0.5);
				}
				.aurora-subtitle {
					color: rgba(255,255,255,0.8);
					margin: 0.5rem 0 0;
					font-size: 1rem;
				}
			</style>
			<nav class="proto-filter-aurora">
				<input type="search" placeholder="Search tracks..."/>
				<select><option>All</option><option>Posts</option><option>Reposts</option></select>
				<select><option>Newest</option><option>Oldest</option><option>Popular</option></select>
				<button>🔄 Sync</button>
			</nav>
			<style>
				.proto-filter-aurora {
					display: flex;
					gap: 0.75rem;
					padding: 1rem 2rem;
					background: linear-gradient(to bottom, rgba(48, 43, 99, 0.9), rgba(15, 12, 41, 0.95));
					border-radius: 0 0 16px 16px;
					flex-wrap: wrap;
				}
				.proto-filter-aurora input, .proto-filter-aurora select {
					background: rgba(255,255,255,0.1);
					border: 1px solid rgba(139, 92, 246, 0.3);
					color: #fff;
					padding: 0.5rem 1rem;
					border-radius: 8px;
				}
				.proto-filter-aurora input::placeholder { color: rgba(255,255,255,0.5); }
				.proto-filter-aurora input:focus, .proto-filter-aurora select:focus {
					border-color: #8b5cf6;
					outline: none;
					background: rgba(255,255,255,0.15);
				}
				.proto-filter-aurora button {
					background: linear-gradient(135deg, #8b5cf6, #7c3aed);
					color: #fff;
					border: none;
					padding: 0.5rem 1.25rem;
					border-radius: 8px;
					cursor: pointer;
					font-weight: 600;
				}
			</style>
		</div>

		<!-- THEME 2: Sunset Glow - Warm oranges and pinks -->
		<div style="margin-bottom: 3rem;">
			<header class="proto-header-sunset">
				<div class="sunset-content">
					<h1>Your Stream</h1>
					<p>Music from the people you follow</p>
				</div>
			</header>
			<style>
				.proto-header-sunset {
					padding: 3rem 2rem;
					background: linear-gradient(135deg, #ff6b35 0%, #f7931e 50%, #ff3366 100%);
					border-radius: 16px 16px 0 0;
					position: relative;
				}
				.proto-header-sunset::after {
					content: '';
					position: absolute;
					top: 0;
					left: 0;
