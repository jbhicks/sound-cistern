templ TrackCardGradient1(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	streamURL string,
) {
	<article class="track-card-gradient track-card-gradient-1" data-track-id={ trackID } data-stream-url={ streamURL }>
		<img src={ artworkURL } alt={ trackTitle } loading="lazy" class="track-card-gradient-bg"/>
		<div class="track-card-gradient-overlay">
			<button class="track-card-gradient-play" aria-label="Play track">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
			</button>
			<div class="track-card-gradient-content">
				<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-gradient-title">{ trackTitle }</a>
				<div class="track-card-gradient-artist">{ artistName }</div>
				<div class="track-card-gradient-stats">
					<span>▶ { formatCompact(playbackCount) }</span>
					<span>♡ { formatCompact(favoritingsCount) }</span>
					if genre != "" {
						<span class="track-card-gradient-genre">{ genre }</span>
					}
				</div>
			</div>
			<div class="track-card-gradient-duration">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</div>
		</div>
	</article>
}

templ TrackCardGradient2(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	streamURL string,
) {
	<article class="track-card-gradient track-card-gradient-2" data-track-id={ trackID } data-stream-url={ streamURL }>
		<img src={ artworkURL } alt={ trackTitle } loading="lazy" class="track-card-gradient-bg"/>
		<div class="track-card-gradient-hover-overlay">
			<button class="track-card-gradient-play-lg" aria-label="Play track">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
			</button>
			<div class="track-card-gradient-hover-content">
				<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-gradient-title-lg">{ trackTitle }</a>
				<div class="track-card-gradient-artist-lg">{ artistName }</div>
				<div class="track-card-gradient-meta-row">
					<span class="track-card-gradient-stat">▶ { formatCompact(playbackCount) }</span>
					<span class="track-card-gradient-stat">♡ { formatCompact(favoritingsCount) }</span>
					if genre != "" {
						<span class="track-card-gradient-tag">{ genre }</span>
					}
					if bpm > 0 {
						<span class="track-card-gradient-tag">{ fmt.Sprintf("%.0f BPM", bpm) }</span>
					}
				</div>
			</div>
			<div class="track-card-gradient-duration-lg">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</div>
		</div>
	</article>
}

