		</div>
	</article>
}

templ TrackCardVerticalProto4(
	trackID string,
	trackTitle string,
	artistName string,
	artistAvatarURL string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	createdAt string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	releaseYear int,
	downloadable bool,
) {
	<article class="track-card-proto-23" data-track-id={ trackID }>
		<img
			src={ artworkURL }
			alt={ trackTitle }
			loading="lazy"
		/>
		<button 
			class="track-card-proto-23-play"
			aria-label="Play track"
			hx-post={ "/api/queue/" + trackID }
			hx-swap="afterbegin"
			hx-target="#queue-container"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		</button>
		<div class="track-card-proto-23-overlay">
			<div class="track-card-proto-23-header">
				<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-proto-23-title">{ trackTitle }</a>
				<span class="track-card-proto-23-duration">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</span>
			</div>
			<div class="track-card-proto-23-artist">{ artistName }</div>
			<div class="track-card-proto-23-meta">
				<div class="track-card-proto-23-stats">
					<span class="track-card-proto-23-stat">▶ { formatCompact(playbackCount) }</span>
					<span class="track-card-proto-23-stat">♡ { formatCompact(favoritingsCount) }</span>
				</div>
				<div class="track-card-proto-23-tags">
					if genre != "" {
						<span class="track-card-proto-23-tag">{ genre }</span>
					}
					if bpm > 0 {
						<span class="track-card-proto-23-tag">{ fmt.Sprintf("%.0f", bpm) } BPM</span>
					}
				</div>
			</div>
		</div>
	</article>
}

templ TrackCardVerticalProto5(
