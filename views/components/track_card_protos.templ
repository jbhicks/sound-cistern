templ TrackCardGradient10(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	streamURL string,
) {
	<article class="track-card-gradient track-card-gradient-10" data-track-id={ trackID } data-stream-url={ streamURL }>
		<img src={ artworkURL } alt={ trackTitle } loading="lazy" class="track-card-gradient-bg-wide"/>
		<div class="track-card-gradient-cinematic">
			<button class="track-card-gradient-play-cinema" aria-label="Play track">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
			</button>
			<div class="track-card-gradient-waveform">
				for i := 0; i < 40; i++ {
					<span class="cinema-bar" style={ templ.SafeCSS(fmt.Sprintf("height: %d%%", 20+((i*13+i*i)%60))) }></span>
				}
			</div>
			<div class="track-card-gradient-cinema-content">
				<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-gradient-title-cinema">{ trackTitle }</a>
				<div class="track-card-gradient-cinema-meta">
					<span class="track-card-gradient-artist-cinema">{ artistName }</span>
					<span class="track-card-gradient-duration-cinema">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</span>
				</div>
				<div class="track-card-gradient-cinema-stats">
					<span>▶ { formatCompact(playbackCount) }</span>
					<span>♡ { formatCompact(favoritingsCount) }</span>
					if genre != "" {
						<span class="track-card-gradient-genre-cinema">{ genre }</span>
					}
					if bpm > 0 {
						<span>{ fmt.Sprintf("%.0f BPM", bpm) }</span>
					}
				</div>
			</div>
		</div>
	</article>
}
