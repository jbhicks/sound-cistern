}

templ TrackCardVerticalProto6(
	trackID string,
	trackTitle string,
	artistName string,
	artistAvatarURL string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	createdAt string,
	playbackCount int64,
	favoritingsCount int64,
	repostsCount int64,
	bpm float64,
	releaseYear int,
	downloadable bool,
	streamURL string,
	waveformURL string,
) {
	<article class="track-card-proto-36-enhanced" data-track-id={ trackID } data-stream-url={ streamURL } data-track-title={ trackTitle } data-artist-name={ artistName }>
		<button 
			class="track-card-proto-play-btn"
			style={ templ.SafeCSS("background-image: url(" + artworkURL + ")") }
			aria-label="Play track"
			data-stream-url={ streamURL }
			data-track-title={ trackTitle }
			data-artist-name={ artistName }
		>
		</button>
		<div class="track-card-proto-info">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-proto-title">{ trackTitle }</a>
			<div class="track-card-proto-meta">
				<span class="track-card-proto-artist">{ artistName }</span>
				<span class="track-card-proto-stat track-card-proto-stat--plays">▶ { formatCompact(playbackCount) }</span>
				<span class="track-card-proto-stat track-card-proto-stat--likes">♡ { formatCompact(favoritingsCount) }</span>
				if genre != "" {
					<span class="track-card-proto-genre">{ genre }</span>
				}
			</div>
		</div>
		<div class="track-card-proto-waveform-container">
			<div class="track-card-proto-waveform-fallback">
				for i := 0; i < 20; i++ {
					<span class="waveform-bar" style={ templ.SafeCSS(fmt.Sprintf("height: %d%%", 25+((i*17+i*i)%55))) }></span>
				}
			</div>
		</div>
		<div class="track-card-proto-duration">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</div>
	</article>
}

templ TrackCardPillGenreA(
	trackID string,
	trackTitle string,
	artistName string,
	artistAvatarURL string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	createdAt string,
	playbackCount int64,
	favoritingsCount int64,
	repostsCount int64,
	bpm float64,
	releaseYear int,
	downloadable bool,
	streamURL string,
) {
	<article class="track-card-proto-36-enhanced" data-track-id={ trackID }>
		<button 
			class="track-card-proto-play-btn"
			style={ templ.SafeCSS("background-image: url(" + artworkURL + ")") }
			aria-label="Play track"
		>
		</button>
		<div class="track-card-proto-info">
			<div class="track-card-proto-title-row">
				<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-proto-title">{ trackTitle }</a>
				if genre != "" {
					<span class="track-card-proto-genre-pill-a">{ genre }</span>
				}
			</div>
			<div class="track-card-proto-meta">
				<span class="track-card-proto-artist">{ artistName }</span>
				<span class="track-card-proto-stat track-card-proto-stat--plays">▶ { formatCompact(playbackCount) }</span>
				<span class="track-card-proto-stat track-card-proto-stat--likes">♡ { formatCompact(favoritingsCount) }</span>
			</div>
		</div>
		<div class="track-card-proto-duration">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</div>
	</article>
}

