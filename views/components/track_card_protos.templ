package components

import (
	"fmt"
	"strings"
)

func ternary(cond bool, yes, no string) string {
	if cond {
		return yes
	}
	return no
}

func getInitials(name string) string {
	parts := strings.Split(name, " ")
	if len(parts) >= 2 {
		return strings.ToUpper(string(parts[0][0]) + string(parts[1][0]))
	}
	if len(name) >= 2 {
		return strings.ToUpper(name[:2])
	}
	return "??"
}

func formatCompact(count int64) string {
	if count >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(count)/1000000)
	}
	if count >= 1000 {
		return fmt.Sprintf("%.1fK", float64(count)/1000)
	}
	return fmt.Sprintf("%d", count)
}

func escapeJS(s string) string {
	s = strings.ReplaceAll(s, "'", "\\'")
	s = strings.ReplaceAll(s, "\n", "\\n")
	s = strings.ReplaceAll(s, "\r", "")
	return s
}

templ TrackCardVerticalProto1(
	trackID string,
	trackTitle string,
	artistName string,
	artistAvatarURL string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	createdAt string,
	playbackCount int64,
	favoritingsCount int64,
	commentCount int64,
	repostsCount int64,
	bpm float64,
	releaseYear int,
	downloadable bool,
	isFavorited bool,
) {
	<article class="track-card-proto-50" data-track-id={ trackID }>
		<div class="track-card-proto-img-container">
			if artworkURL != "" {
				<img
					class="track-card-proto-img"
					src={ artworkURL }
					alt={ trackTitle + " by " + artistName }
					loading="lazy"
				/>
			} else {
				<div class="track-card-proto-img-placeholder">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
				</div>
			}
			<div class="track-card-proto-duration-badge">{ trackDuration / 1000 / 60 }:{ fmt.Sprintf("%02d", (trackDuration/1000)%60) }</div>
		</div>
		<div class="track-card-proto-content">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="track-card-proto-title">{ trackTitle }</a>
			<div class="track-card-proto-artist">{ artistName }</div>
			<div class="track-card-proto-tags">
				if genre != "" {
					<span class="track-card-proto-tag">{ genre }</span>
				}
				if bpm > 0 {
					<span class="track-card-proto-tag">{ fmt.Sprintf("%.0f BPM", bpm) }</span>
				}
				if releaseYear > 0 {
					<span class="track-card-proto-tag">{ fmt.Sprintf("%d", releaseYear) }</span>
				}
				if downloadable {
					<span class="track-card-proto-tag track-card-proto-tag-download">↓</span>
				}
			</div>
			<div class="track-card-proto-meta">
				<div class="track-card-proto-stats">
					<span class="track-card-proto-stat" title="Plays">▶ { formatCompact(playbackCount) }</span>
					<span class="track-card-proto-stat" title="Likes">♡ { formatCompact(favoritingsCount) }</span>
					<span class="track-card-proto-stat" title="Reposts">↻ { formatCompact(repostsCount) }</span>
					<span class="track-card-proto-stat" title="Comments">💬 { formatCompact(commentCount) }</span>
				</div>
			</div>
		</div>
	</article>
}

