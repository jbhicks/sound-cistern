package components

import (
	"fmt"
	"strings"
)

templ TrackCard(
	trackID string,
	trackTitle string,
	artistName string,
	artistAvatarURL string,
	genre string,
	tagList string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	createdAt string,
	isFavorited bool,
	playbackCount int64,
	favoritingsCount int64,
	commentCount int64,
	repostsCount int64,
	bpm float64,
	releaseYear int,
	downloadable bool,
) {
	<article class="track-card" data-track-id={ trackID }>
		<div class="track-artwork-wrapper">
			<img
				src={ artworkURL }
				alt={ "Album artwork for " + trackTitle + " by " + artistName }
				class="track-artwork"
				loading="lazy"
				onerror="this.src='/images/default-album-art.png'"
			/>
			if playbackCount > 0 {
				<div class="track-plays-overlay">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
					<span>{ formatCount(playbackCount) }</span>
				</div>
			}
		</div>

		<div class="track-content">
			<div class="track-header">
				if artistAvatarURL != "" {
					<img
						src={ artistAvatarURL }
						alt={ artistName + " avatar" }
						class="artist-avatar"
						loading="lazy"
						onerror="this.style.display='none'"
					/>
				}
				<div class="track-info">
					<h2 class="track-title">
						<a
							href={ templ.URL(permalinkURL) }
							target="_blank"
							rel="noopener noreferrer"
							class="track-title-link"
							aria-label={ "Open " + trackTitle + " by " + artistName + " on Soundcloud in a new tab" }
						>
							{ trackTitle }
						</a>
					</h2>
					<p class="track-artist">{ artistName }</p>
				</div>
			</div>

			<div class="track-tags">
				if genre != "" {
					<span class="track-genre">{ genre }</span>
				}
				if releaseYear > 0 {
					<span class="track-tag track-tag--year">{ fmt.Sprintf("%d", releaseYear) }</span>
				}
				if bpm > 0 {
					<span class="track-tag track-tag--bpm">
						<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
						</svg>
						{ fmt.Sprintf("%.0f", bpm) } BPM
					</span>
				}
				if downloadable {
					<span class="track-tag track-tag--download" title="Downloadable">
						<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
					</span>
				}
				if tagList != "" {
					for _, tag := range parseTags(tagList) {
						if tag != genre {
							<span class="track-tag">{ tag }</span>
						}
					}
				}
			</div>

			<div class="track-stats">
				if playbackCount > 0 {
					<span class="track-stat" aria-label="Play count">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polygon points="5 3 19 12 5 21 5 3"></polygon>
						</svg>
						{ formatCount(playbackCount) }
					</span>
				}
				if favoritingsCount > 0 {
					<span class="track-stat" aria-label="Favorites count">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
						</svg>
						{ formatCount(favoritingsCount) }
					</span>
				}
				if repostsCount > 0 {
					<span class="track-stat" aria-label="Reposts count">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="17 1 21 5 17 9"></polyline>
							<path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
							<polyline points="7 23 3 19 7 15"></polyline>
							<path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
						</svg>
						{ formatCount(repostsCount) }
					</span>
				}
				if commentCount > 0 {
					<span class="track-stat" aria-label="Comment count">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
						</svg>
						{ formatCount(commentCount) }
					</span>
				}
			</div>

			<div class="track-meta">
				<span class="track-duration" aria-label="Track duration">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					{ formatDuration(trackDuration) }
				</span>
				<span class="track-date" aria-label="Added date">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
					{ createdAt }
				</span>
			</div>
		</div>

		<div class="track-actions">
			<a
				href={ templ.URL(permalinkURL) }
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary soundcloud-btn"
				aria-label={ "Play " + trackTitle + " on Soundcloud in a new tab" }
			>
				<span class="btn-icon" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
				</span>
				<span class="btn-text">Play</span>
			</a>

			@FavoriteButton(trackID, trackTitle, isFavorited)
		</div>

		<div class="htmx-indicator" aria-hidden="true">
			<span class="sr-only">Loading...</span>
		</div>
	</article>
}

templ EmptyState(title string, message string, actionText string, actionURL string) {
	<div class="empty-state" role="status" aria-live="polite">
		<div class="empty-state-icon" aria-hidden="true">
			<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M9 18V5l12-2v13"></path>
				<circle cx="6" cy="18" r="3"></circle>
				<circle cx="18" cy="16" r="3"></circle>
			</svg>
		</div>
		<h2 class="empty-state-title">{ title }</h2>
		<p class="empty-state-message">{ message }</p>
		if actionText != "" && actionURL != "" {
			<a href={ templ.URL(actionURL) } class="btn btn-primary" role="button">
				{ actionText }
			</a>
		}
	</div>
}

templ LoadingState(message string) {
	<div class="loading-state" role="status" aria-live="polite" aria-busy="true">
		<div class="loading-spinner" aria-hidden="true">
			<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="10">
					<animateTransform
						attributeName="transform"
						attributeType="XML"
						type="rotate"
						from="0 12 12"
						to="360 12 12"
						dur="1s"
						repeatCount="indefinite"
					/>
				</circle>
			</svg>
		</div>
		<p class="loading-message">{ message }</p>
	</div>
}

templ SkeletonCard() {
	<div class="track-card skeleton-card" aria-hidden="true">
		<div class="skeleton skeleton-artwork"></div>
		<div class="track-content">
			<div class="skeleton skeleton-title"></div>
			<div class="skeleton skeleton-artist"></div>
			<div class="skeleton skeleton-meta"></div>
		</div>
		<div class="track-actions">
			<div class="skeleton skeleton-btn"></div>
			<div class="skeleton skeleton-btn skeleton-btn--small"></div>
		</div>
	</div>
}

func formatDuration(ms int64) string {
	seconds := ms / 1000
	minutes := seconds / 60
	remainingSeconds := seconds % 60
	return fmt.Sprintf("%d:%02d", minutes, remainingSeconds)
}

func formatCount(count int64) string {
	if count >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(count)/1000000)
	}
	if count >= 1000 {
		return fmt.Sprintf("%.1fK", float64(count)/1000)
	}
	return fmt.Sprintf("%d", count)
}

func parseTags(tagList string) []string {
	tags := strings.Split(tagList, ",")
	result := make([]string, 0, len(tags))
	for _, tag := range tags {
		trimmed := strings.TrimSpace(tag)
		if trimmed != "" {
			result = append(result, trimmed)
		}
	}
	if len(result) > 3 {
		return result[:3]
	}
	return result
}

func getFavoriteLabel(isFavorited bool, trackTitle string) string {
	if isFavorited {
		return "Remove " + trackTitle + " from favorites"
	}
	return "Add " + trackTitle + " to favorites"
}

func getFavoriteText(isFavorited bool) string {
	if isFavorited {
		return "Favorited"
	}
	return "Favorite"
}

func getAriaPressed(isFavorited bool) string {
	if isFavorited {
		return "true"
	}
	return "false"
}