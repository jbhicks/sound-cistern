package components

import "fmt"

// TrackCard renders an individual track card with accessibility features
// Uses semantic HTML with <article> element and proper ARIA labels
// Note: Uses individual parameters to avoid import cycle with views package
templ TrackCard(
	trackID string,
	trackTitle string,
	artistName string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	createdAt string,
	isFavorited bool,
) {
	<article class="track-card" data-track-id={ trackID }>
		<!-- Artwork section with proper alt text -->
		<div class="track-artwork-wrapper">
			<img 
				src={ artworkURL } 
				alt={ "Album artwork for " + trackTitle + " by " + artistName }
				class="track-artwork"
				loading="lazy"
				onerror="this.src='/images/default-album-art.png'"
			/>
		</div>
		
		<!-- Track content with semantic structure -->
		<div class="track-content">
			<!-- Track title as heading for proper document outline -->
			<h2 class="track-title">
				<a 
					href={ templ.URL(permalinkURL) }
					target="_blank"
					rel="noopener noreferrer"
					class="track-title-link"
					aria-label={ "Open " + trackTitle + " by " + artistName + " on Soundcloud in a new tab" }
				>
					{ trackTitle }
				</a>
			</h2>
			
			<!-- Artist name -->
			<p class="track-artist">{ artistName }</p>
			
			<!-- Metadata row with duration and date -->
			<div class="track-meta">
				<span class="track-duration" aria-label="Track duration">
					<span class="meta-icon" aria-hidden="true">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
					</span>
					<span class="meta-value" data-duration={ fmt.Sprintf("%d", trackDuration) }>
						{ formatDuration(trackDuration) }
					</span>
				</span>
				<span class="track-date" aria-label="Added date">
					<span class="meta-icon" aria-hidden="true">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
							<line x1="16" y1="2" x2="16" y2="6"></line>
							<line x1="8" y1="2" x2="8" y2="6"></line>
							<line x1="3" y1="10" x2="21" y2="10"></line>
						</svg>
					</span>
					<span class="meta-value">
						{ createdAt }
					</span>
				</span>
			</div>
		</div>
		
		<!-- Action buttons with proper ARIA labels and touch targets -->
		<div class="track-actions">
			<a 
				href={ templ.URL(permalinkURL) }
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary soundcloud-btn"
				aria-label={ "Play " + trackTitle + " on Soundcloud in a new tab" }
			>
				<span class="btn-icon" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
				</span>
				<span class="btn-text">Play</span>
			</a>
			
		<button 
			type="button"
			class={ "btn btn-secondary favorite-btn", templ.KV("favorited", isFavorited) }
			data-track-id={ trackID }
			data-track-title={ trackTitle }
			aria-label={ getFavoriteLabel(isFavorited, trackTitle) }
			aria-pressed={ getAriaPressed(isFavorited) }
			onclick="toggleFavorite(this)"
		>
			<span class="btn-icon favorite-icon" aria-hidden="true">
				if isFavorited {
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
						<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
					</svg>
				} else {
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
					</svg>
				}
			</span>
			<span class="btn-text">{ getFavoriteText(isFavorited) }</span>
			<span class="btn-loading" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="10">
						<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
					</circle>
				</svg>
			</span>
		</button>
		</div>
		
		<!-- HTMX loading indicator (hidden by default) -->
		<div class="htmx-indicator" aria-hidden="true">
			<span class="sr-only">Loading...</span>
		</div>
	</article>
}

// EmptyState renders an accessible empty state message
templ EmptyState(title string, message string, actionText string, actionURL string) {
	<div class="empty-state" role="status" aria-live="polite">
		<div class="empty-state-icon" aria-hidden="true">
			<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M9 18V5l12-2v13"></path>
				<circle cx="6" cy="18" r="3"></circle>
				<circle cx="18" cy="16" r="3"></circle>
			</svg>
		</div>
		<h2 class="empty-state-title">{ title }</h2>
		<p class="empty-state-message">{ message }</p>
		if actionText != "" && actionURL != "" {
			<a href={ templ.URL(actionURL) } class="btn btn-primary" role="button">
				{ actionText }
			</a>
		}
	</div>
}

// LoadingState renders an accessible loading indicator
templ LoadingState(message string) {
	<div class="loading-state" role="status" aria-live="polite" aria-busy="true">
		<div class="loading-spinner" aria-hidden="true">
			<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="10">
					<animateTransform
						attributeName="transform"
						attributeType="XML"
						type="rotate"
						from="0 12 12"
						to="360 12 12"
						dur="1s"
						repeatCount="indefinite"
					/>
				</circle>
			</svg>
		</div>
		<p class="loading-message">{ message }</p>
	</div>
}

// SkeletonCard renders a loading skeleton for a track card
templ SkeletonCard() {
	<div class="track-card skeleton-card" aria-hidden="true">
		<div class="skeleton skeleton-artwork"></div>
		<div class="track-content">
			<div class="skeleton skeleton-title"></div>
			<div class="skeleton skeleton-artist"></div>
			<div class="skeleton skeleton-meta"></div>
		</div>
		<div class="track-actions">
			<div class="skeleton skeleton-btn"></div>
			<div class="skeleton skeleton-btn skeleton-btn--small"></div>
		</div>
	</div>
}

// Helper functions

func formatDuration(ms int64) string {
	seconds := ms / 1000
	minutes := seconds / 60
	remainingSeconds := seconds % 60
	return fmt.Sprintf("%d:%02d", minutes, remainingSeconds)
}

func getFavoriteLabel(isFavorited bool, trackTitle string) string {
	if isFavorited {
		return "Remove " + trackTitle + " from favorites"
	}
	return "Add " + trackTitle + " to favorites"
}

func getFavoriteText(isFavorited bool) string {
	if isFavorited {
		return "Favorited"
	}
	return "Favorite"
}

func getAriaPressed(isFavorited bool) string {
	if isFavorited {
		return "true"
	}
	return "false"
}