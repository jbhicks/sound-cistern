package components

import (
	"github.com/pocketbase/pocketbase/models"
)

// NavigationData represents data needed for the navigation component
type NavigationData struct {
	CurrentPath string
	User        interface{}
}

// SkipToContent provides a skip link for keyboard accessibility
templ SkipToContent() {
	<!-- Skip to main content link for keyboard accessibility -->
	<a href="#main-content" class="skip-to-content">
		Skip to main content
	</a>
}

// ThemeToggle provides an accessible theme toggle button
templ ThemeToggle() {
	<!-- Theme toggle with aria-pressed for toggle state -->
	<button 
		class="theme-toggle-btn" 
		onclick="toggleTheme()" 
		id="theme-icon-header" 
		aria-label="Toggle between light and dark mode"
		aria-pressed="false"
		type="button"
	>
		<!-- Icon will be set by JavaScript -->
	</button>
}

// MainNavigation provides the site-wide navigation with semantic markup
templ MainNavigation(data NavigationData) {
	<!-- Main site header with banner role -->
	<header class="site-header" role="banner">
		<!-- Primary navigation with semantic nav element -->
		<nav 
			class="container-fluid main-nav" 
			aria-label="Main navigation"
			role="navigation"
		>
			<!-- Logo/Brand section -->
			<ul class="nav-brand">
				<li>
					<strong>
						<a href="/" class="logo" aria-label="Sound Cistern - Home">
							Sound Cistern
						</a>
					</strong>
				</li>
			</ul>
			
			<!-- Main navigation links -->
			<ul class="nav-links">
				<li>
					<a 
						href="/blog" 
						aria-current={ getAriaCurrent(data.CurrentPath, "/blog") }
						class={ getNavClass(data.CurrentPath, "/blog") }
					>
						Blog
					</a>
				</li>
				<li>
					<a 
						href="/stream" 
						aria-current={ getAriaCurrent(data.CurrentPath, "/stream") }
						class={ getNavClass(data.CurrentPath, "/stream") }
					>
						Stream
					</a>
				</li>
				<li>
					<a 
						href="/favorites" 
						aria-current={ getAriaCurrent(data.CurrentPath, "/favorites") }
						class={ getNavClass(data.CurrentPath, "/favorites") }
					>
						Favorites
					</a>
				</li>
				
				<!-- Theme toggle - always visible -->
				<li class="nav-item-theme">
					@ThemeToggle()
				</li>
				
				<!-- Authentication links -->
				if data.User != nil {
					if userRecord, ok := data.User.(*models.Record); ok {
						<li class="nav-item-user">
							<details class="dropdown user-menu">
								<summary 
									role="button" 
									aria-haspopup="true"
									aria-label={ "User menu for " + userRecord.GetString("username") }
									class={ getNavClass(data.CurrentPath, "/dashboard") }
								>
									Dashboard
								</summary>
								<ul role="menu" aria-label="User actions">
									<li role="none">
										<a href="/dashboard" role="menuitem">Dashboard</a>
									</li>
									<li role="none">
										<a href="/settings" role="menuitem">Settings</a>
									</li>
									<li role="none">
										<a href="/signout" role="menuitem">Sign out</a>
									</li>
								</ul>
							</details>
						</li>
					} else {
						<li><a href="/dashboard">Dashboard</a></li>
						<li><a href="/signout">Sign out</a></li>
					}
				} else {
					<li class="nav-item-auth">
						<a href="/signin" class="nav-link-signin">Sign in</a>
					</li>
					<li class="nav-item-auth">
						<a href="/signup" role="button" class="nav-link-signup">Sign up</a>
					</li>
				}
			</ul>
		</nav>
	</header>
}

// Helper function to determine aria-current attribute
func getAriaCurrent(currentPath, targetPath string) string {
	if currentPath == targetPath {
		return "page"
	}
	return "false"
}

// Helper function to determine active navigation class
func getNavClass(currentPath, targetPath string) string {
	if currentPath == targetPath {
		return "secondary"
	}
	return ""
}

// SiteFooter provides a semantic footer
templ SiteFooter() {
	<!-- Site footer with contentinfo role -->
	<footer class="site-footer" role="contentinfo">
		<div class="container">
			<p>&copy; 2026 Sound Cistern. All rights reserved.</p>
		</div>
	</footer>
}
