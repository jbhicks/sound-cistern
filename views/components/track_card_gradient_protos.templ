			<div class="vcard-minimal-stat">
				<span class="vcard-minimal-line"></span>
				<span class="vcard-minimal-val">{ formatCompact(favoritingsCount) }</span>
				<span class="vcard-minimal-label">likes</span>
			</div>
		</div>
		<button class="vcard-minimal-play" aria-label="Play" onclick={ playTrack(trackID, streamURL, trackTitle, artistName) }>
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		</button>
		<div class="vcard-minimal-info">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="vcard-minimal-title">{ trackTitle }</a>
			<span class="vcard-minimal-artist">{ artistName }</span>
			<div class="vcard-minimal-meta">
				<span class="vcard-minimal-time">{ formatDuration(trackDuration) }</span>
				if genre != "" {
					<span class="vcard-minimal-genre">{ genre }</span>
				}
			</div>
		</div>
	</article>
}

// A3 Variation 8: Cyberpunk Neon - Neon glows, dark theme, futuristic
templ VignetteCard3_Cyberpunk(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	releaseYear int,
	commentCount int64,
	repostsCount int64,
	streamURL string,
) {
	<article class="vcard vcard-3-cyber" data-track-id={ trackID } data-stream-url={ streamURL }>
		<img src={ artworkURL } alt={ trackTitle } class="vcard-art"/>
		<div class="vcard-cyber-scanlines"></div>
		<div class="vcard-cyber-grid">
			<div class="vcard-cyber-stat vcard-cyber-stat--plays">
				<span class="vcard-cyber-icon">▶</span>
				<span class="vcard-cyber-val">{ formatCompact(playbackCount) }</span>
			</div>
			<div class="vcard-cyber-stat vcard-cyber-stat--likes">
				<span class="vcard-cyber-icon">♡</span>
				<span class="vcard-cyber-val">{ formatCompact(favoritingsCount) }</span>
			</div>
			<div class="vcard-cyber-stat vcard-cyber-stat--reposts">
				<span class="vcard-cyber-icon">↻</span>
				<span class="vcard-cyber-val">{ formatCompact(repostsCount) }</span>
			</div>
		</div>
		<button class="vcard-cyber-play" aria-label="Play" onclick={ playTrack(trackID, streamURL, trackTitle, artistName) }>
			<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		</button>
		<div class="vcard-cyber-info">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="vcard-cyber-title">{ trackTitle }</a>
			<span class="vcard-cyber-artist">{ artistName }</span>
			<div class="vcard-cyber-tags">
				<span class="vcard-cyber-tag vcard-cyber-tag--time">{ formatDuration(trackDuration) }</span>
				if genre != "" {
					<span class="vcard-cyber-tag vcard-cyber-tag--genre">{ genre }</span>
				}
				if bpm > 0 {
					<span class="vcard-cyber-tag vcard-cyber-tag--bpm">{ fmt.Sprintf("%.0f BPM", bpm) }</span>
				}
			</div>
		</div>
	</article>
}

// A3 Variation 9: Vinyl Record - Spinning record aesthetic
templ VignetteCard3_Vinyl(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	releaseYear int,
	commentCount int64,
	repostsCount int64,
	streamURL string,
) {
	<article class="vcard vcard-3-vinyl" data-track-id={ trackID } data-stream-url={ streamURL }>
		<div class="vcard-vinyl-disc">
			<div class="vcard-vinyl-artwork" style={ fmt.Sprintf("background-image: url(%s)", artworkURL) }></div>
			<div class="vcard-vinyl-grooves"></div>
			<div class="vcard-vinyl-label">
				<span class="vcard-vinyl-label-text">{ artistName }</span>
			</div>
		</div>
		<div class="vcard-vinyl-stats">
			<div class="vcard-vinyl-stat">
				<span class="vcard-vinyl-stat-icon">♡</span>
				<span class="vcard-vinyl-stat-val">{ formatCompact(favoritingsCount) }</span>
			</div>
			<div class="vcard-vinyl-stat">
				<span class="vcard-vinyl-stat-icon">↻</span>
				<span class="vcard-vinyl-stat-val">{ formatCompact(repostsCount) }</span>
			</div>
		</div>
		<button class="vcard-vinyl-play" aria-label="Play" onclick={ playTrack(trackID, streamURL, trackTitle, artistName) }>
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		</button>
		<div class="vcard-vinyl-info">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="vcard-vinyl-title">{ trackTitle }</a>
			<span class="vcard-vinyl-artist">{ artistName }</span>
			<div class="vcard-vinyl-footer">
				<span class="vcard-vinyl-time">{ formatDuration(trackDuration) }</span>
				if genre != "" {
					<span class="vcard-vinyl-genre">{ genre }</span>
				}
			</div>
		</div>
	</article>
}

// A3 Variation 10: Polaroid Stack - Stacked photo cards with handwritten style
templ VignetteCard3_Polaroid(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	releaseYear int,
	commentCount int64,
	repostsCount int64,
	streamURL string,
) {
	<article class="vcard vcard-3-polaroid" data-track-id={ trackID } data-stream-url={ streamURL }>
		<div class="vcard-polaroid-stack">
			<div class="vcard-polaroid-card vcard-polaroid-card--back"></div>
			<div class="vcard-polaroid-card vcard-polaroid-card--mid"></div>
			<div class="vcard-polaroid-card vcard-polaroid-card--front">
				<img src={ artworkURL } alt={ trackTitle } class="vcard-art"/>
			</div>
		</div>
		<div class="vcard-polaroid-stats">
			<div class="vcard-polaroid-stat">
				<span class="vcard-polaroid-heart">♡</span>
				<span class="vcard-polaroid-count">{ formatCompact(favoritingsCount) }</span>
			</div>
		</div>
		<button class="vcard-polaroid-play" aria-label="Play" onclick={ playTrack(trackID, streamURL, trackTitle, artistName) }>
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		</button>
		<div class="vcard-polaroid-caption">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="vcard-polaroid-title">{ trackTitle }</a>
			<span class="vcard-polaroid-artist">{ artistName }</span>
			<span class="vcard-polaroid-time">{ formatDuration(trackDuration) }</span>
			if genre != "" {
				<span class="vcard-polaroid-genre">{ genre }</span>
			}
		</div>
	</article>
}
