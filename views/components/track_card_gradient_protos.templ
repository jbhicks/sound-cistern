// Glass Variation 4: Corner Clusters - Stats grouped in corners
templ GlassCard_Corners(
	trackID string,
	trackTitle string,
	artistName string,
	genre string,
	trackDuration int64,
	artworkURL string,
	permalinkURL string,
	playbackCount int64,
	favoritingsCount int64,
	bpm float64,
	releaseYear int,
	commentCount int64,
	repostsCount int64,
	streamURL string,
) {
	<article class="vcard glass-v4" data-track-id={ trackID } data-stream-url={ streamURL }>
		<img src={ artworkURL } alt={ trackTitle } class="vcard-art"/>
		<div class="glass-v4-overlay"></div>
		<div class="glass-v4-corner glass-v4-tl">
			<span class="glass-v4-pill">{ formatCompact(playbackCount) } plays</span>
		</div>
		<div class="glass-v4-corner glass-v4-tr">
			<span class="glass-v4-pill">{ formatCompact(favoritingsCount) } likes</span>
		</div>
		<div class="glass-v4-corner glass-v4-bl">
			if genre != "" {
				<span class="glass-v4-pill glass-v4-pill--accent">{ genre }</span>
			}
		</div>
		<div class="glass-v4-corner glass-v4-br">
			<span class="glass-v4-pill">{ formatDuration(trackDuration) }</span>
		</div>
		<button class="glass-v4-play" aria-label="Play" onclick={ playTrack(trackID, streamURL, trackTitle, artistName) }>
			<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		</button>
		<div class="glass-v4-center">
			<a href={ templ.URL(permalinkURL) } target="_blank" class="glass-v4-title">{ trackTitle }</a>
			<span class="glass-v4-artist">{ artistName }</span>
		</div>
	</article>
}

