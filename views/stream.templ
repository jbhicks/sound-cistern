package views

import (
	"fmt"
	"time"
)

func formatTrackDate(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("Jan 2, 2006")
}

func formatDurationMinutes(minutes int64) string {
	if minutes < 60 {
		return fmt.Sprintf("%d min", minutes)
	}
	hours := minutes / 60
	mins := minutes % 60
	if mins == 0 {
		return fmt.Sprintf("%d hr", hours)
	}
	return fmt.Sprintf("%d hr %d min", hours, mins)
}

func formatInt64(n int64) string {
	return fmt.Sprintf("%d", n)
}

func formatCompact(n int64) string {
	if n == 0 {
		return "0"
	}
	if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	}
	if n >= 1000 {
		return fmt.Sprintf("%.1fK", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

type StreamData struct {
	PageData
	Tracks       []Track
	ActiveTab    string
	ViewMode     string
	Filters      map[string]interface{}
	IsLoggedIn   string
	MinDuration  int64  // in minutes
	MaxDuration  int64  // in minutes
}

templ Stream(data StreamData) {
	@Layout(data.PageData) {
		<main class="container">
			<!-- Vapor Wave Filter Bar -->
			<div class="vapor-filter-bar">
				<div class="vapor-filter-main">
					<div class="vapor-search">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
						<input 
							type="text" 
							name="q"
							id="filter-q"
							placeholder="Search..."
							autocomplete="off"
							hx-get="/api/stream"
							hx-target="#track-container"
							hx-trigger="input delay:300ms"
							hx-include="#filter-content-type,#filter-sort,#filter-limit"
						/>
					</div>
					
					<div class="vapor-filters">
						<select name="content_type" id="filter-content-type" hx-get="/api/stream" hx-target="#track-container" hx-trigger="change">
							<option value="">All</option>
							<option value="posts">Posts</option>
							<option value="reposts">Reposts</option>
						</select>
						<select name="sort" id="filter-sort" hx-get="/api/stream" hx-target="#track-container" hx-trigger="change">
							<option value="newest">Newest</option>
							<option value="oldest">Oldest</option>
							<option value="title">Title</option>
							<option value="artist">Artist</option>
							<option value="duration">Duration</option>
						</select>
					</div>
					
					<div class="vapor-actions">
						<select name="limit" id="filter-limit" hx-get="/api/stream?refresh=true" hx-target="#track-container" hx-trigger="change">
							<option value="20">20</option>
							<option value="50">50</option>
							<option value="100">100</option>
						</select>
						<button type="button" class="vapor-btn vapor-btn-sync" id="sync-btn" onclick="syncTracks()">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
							Sync
						</button>
						<button type="button" class="vapor-btn vapor-btn-clear" onclick="resetFilters()">
							Reset
						</button>
					</div>
				</div>
				
				<div class="vapor-filter-row">
					<label class="vapor-duration">
						<span>Min Duration: <strong id="duration-min-display">{ formatDurationMinutes(data.MinDuration) }</strong></span>
						<input type="range" id="duration-range" min="0" max={ formatInt64(data.MaxDuration) } value={ formatInt64(data.MinDuration) } 
							hx-get="/api/stream?refresh=true"
							hx-target="#track-container"
							hx-trigger="input delay:300ms"
							hx-include="#filter-q,#filter-content-type,#filter-sort,#filter-limit"
							name="duration_min"
							oninput="updateDurationDisplay(this.value)"
						/>
					</label>
				</div>
			</div>

			<div id="loading" aria-busy="true" hidden>
				<small>Loading tracks...</small>
			</div>

		<div id="track-container">
			if len(data.Tracks) > 0 {
				<div class="stream-flip-grid">
					for _, track := range data.Tracks {
						<div class="stream-flip-card" 
							data-track-id={ track.TrackID } 
							data-stream-url={ "/api/track/" + track.TrackID + "/stream" }
							data-track-title={ track.TrackTitle }
							data-artist-name={ track.ArtistName }
							onclick="handleStreamFlip(this)">
							<div class="stream-flip">
								<div class="stream-flip-front">
									<img src={ track.ArtworkURL } alt={ track.TrackTitle }/>
									<div class="stream-flip-info">
										<div class="stream-flip-title">{ track.TrackTitle }</div>
										<div class="stream-flip-artist">{ track.ArtistName }</div>
										<div class="stream-flip-stats">
											<span class="stat-plays">▶ { formatCompact(track.PlaybackCount) }</span>
											<span class="stat-likes">♡ { formatCompact(track.FavoritingsCount) }</span>
											<span class="stat-duration">{ formatDuration(track.TrackDuration) }</span>
										</div>
										if track.Genre != "" {
											<div class="stream-flip-genre">{ track.Genre }</div>
										}
									</div>
								</div>
								<div class="stream-flip-back">
									<div class="stream-flip-vinyl">
										<div class="stream-flip-label">
											<img src={ track.ArtworkURL } alt=""/>
										</div>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			} else {
					<article>
						<hgroup>
							<h3>No tracks yet</h3>
							<p>Connect your Soundcloud account to see your stream.</p>
						</hgroup>
						<footer>
							<a href="/dashboard" role="button">Connect Soundcloud</a>
						</footer>
					</article>
				}
			</div>

			<div style="text-align: center; margin-top: 1rem;" id="load-more-sentinel">
				<button 
					class="btn btn-secondary load-more-btn"
					id="load-more-btn"
					data-page="2"
					data-loaded="0"
					hx-get="/api/stream"
					hx-vals='{"page":"2"}'
					hx-include="#filter-q,#filter-content-type,#filter-sort,#filter-limit,#duration-range"
					hx-target="#track-container"
					hx-swap="beforeend"
					hx-trigger="revealed"
					hx-indicator="#load-more-indicator"
					hx-on::after-request="handleLoadMore(this, event)"
					aria-label="Load more tracks"
				>
					Load More
				</button>
				<span id="load-more-indicator" class="htmx-indicator" aria-busy="true" hidden>
					<small>Loading more...</small>
				</span>
				<small id="no-more" hidden>All tracks loaded</small>
			</div>
		</main>

		<div id="player-container"></div>

		<style>
			.player-bar {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				background: #1a1a1a;
				color: white;
				padding: 0.75rem 1rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				z-index: 1000;
				font-family: system-ui, sans-serif;
			}
			.player-bar img {
				width: 48px;
				height: 48px;
				border-radius: 4px;
				object-fit: cover;
			}
			.player-bar-info {
				flex: 1;
				min-width: 0;
			}
			.player-bar-title {
				font-weight: 600;
				font-size: 0.9rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.player-bar-artist {
				font-size: 0.75rem;
				color: #999;
			}
			.player-bar audio {
				width: 300px;
				height: 32px;
			}
			.player-bar .close-btn {
				background: none;
				border: none;
				color: #666;
				cursor: pointer;
				font-size: 1.25rem;
				padding: 0.25rem;
			}
			.player-bar .close-btn:hover {
				color: white;
			}
			
			/* Vapor Wave Filter Bar */
			.vapor-filter-bar {
				background: linear-gradient(135deg, rgba(26, 10, 46, 0.6), rgba(22, 33, 62, 0.6));
				padding: 0.75rem 1rem;
				border-radius: 12px;
				margin-bottom: 1rem;
				border: 1px solid rgba(255, 107, 157, 0.2);
				backdrop-filter: blur(10px);
			}
			.vapor-filter-main {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem;
			}
			.vapor-search {
				flex: 1;
				min-width: 180px;
				position: relative;
				display: flex;
				align-items: center;
			}
			.vapor-search svg {
				position: absolute;
				left: 10px;
				color: rgba(255, 107, 157, 0.6);
				pointer-events: none;
				width: 14px;
				height: 14px;
			}
			.vapor-search input {
				width: 100%;
				background: rgba(0, 0, 0, 0.3);
				border: 1px solid rgba(0, 212, 255, 0.3);
				color: #fff;
				padding: 0.5rem 1rem 0.5rem 2rem;
				border-radius: 8px;
				font-size: 0.85rem;
				appearance: none;
				-webkit-appearance: none;
			}
			.vapor-search input::-webkit-search-decoration,
			.vapor-search input::-webkit-search-cancel-button,
			.vapor-search input::-webkit-search-results-button,
			.vapor-search input::-webkit-search-results-decoration {
				-webkit-appearance: none;
				display: none;
			}
			.vapor-search input::placeholder {
				color: rgba(255, 107, 157, 0.6);
			}
			.vapor-search input:focus {
				border-color: #ff6b9d;
				outline: none;
				box-shadow: 0 0 15px rgba(255, 107, 157, 0.3);
			}
			.vapor-filters, .vapor-actions {
				display: flex;
				gap: 0.5rem;
			}
			.vapor-filters select, .vapor-actions select {
				background: rgba(0, 0, 0, 0.3);
				border: 1px solid rgba(0, 212, 255, 0.3);
				color: #fff;
				padding: 0.5rem 0.75rem;
				border-radius: 8px;
				font-size: 0.85rem;
				cursor: pointer;
			}
			.vapor-filters select:focus, .vapor-actions select:focus {
				border-color: #ff6b9d;
				outline: none;
				box-shadow: 0 0 15px rgba(255, 107, 157, 0.3);
			}
			.vapor-filters select option, .vapor-actions select option {
				background: #1a0a2e;
				color: #fff;
			}
			.vapor-filter-row {
				margin-top: 0.75rem;
				padding-top: 0.75rem;
				border-top: 1px solid rgba(255, 107, 157, 0.15);
			}
			.vapor-filter-row .vapor-duration {
				display: flex;
				align-items: center;
				gap: 1rem;
				width: 100%;
			}
			.vapor-filter-row .vapor-duration label {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				color: #ff6b9d;
				font-size: 0.8rem;
				white-space: nowrap;
			}
			.vapor-filter-row .vapor-duration label strong {
				color: #00d4ff;
				min-width: 60px;
			}
			.vapor-filter-row input[type="range"] {
				flex: 1;
				height: 6px;
				-webkit-appearance: none;
				background: rgba(0, 0, 0, 0.3);
				border-radius: 3px;
				cursor: pointer;
			}
			.vapor-filter-row input[type="range"]::-webkit-slider-thumb {
				-webkit-appearance: none;
				width: 16px;
				height: 16px;
				background: linear-gradient(135deg, #00d4ff, #8b5cf6);
				border-radius: 50%;
				cursor: pointer;
			}
			.vapor-filter-row input[type="range"]::-moz-range-thumb {
				width: 16px;
				height: 16px;
				background: linear-gradient(135deg, #00d4ff, #8b5cf6);
				border-radius: 50%;
				cursor: pointer;
				border: none;
			}
			.vapor-btn {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.5rem 0.85rem;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				border: none;
				font-size: 0.8rem;
				transition: all 0.2s ease;
			}
			.vapor-btn-sync {
				background: linear-gradient(135deg, #ff6b9d, #e94560);
				color: #fff;
				box-shadow: 0 2px 10px rgba(233, 69, 96, 0.3);
			}
			.vapor-btn-sync:hover {
				box-shadow: 0 4px 15px rgba(233, 69, 96, 0.5);
				transform: translateY(-1px);
			}
			.vapor-btn-sync:disabled {
				opacity: 0.7;
				cursor: not-allowed;
			}
			.vapor-btn-clear {
				background: rgba(0, 212, 255, 0.15);
				border: 1px solid rgba(0, 212, 255, 0.4);
				color: #00d4ff;
			}
			.vapor-btn-clear:hover {
				background: rgba(255, 107, 157, 0.15);
				border-color: #ff6b9d;
				color: #ff6b9d;
			}
			
			@media (max-width: 768px) {
				.vapor-filter-main {
					flex-direction: column;
					align-items: stretch;
				}
				.vapor-search {
					order: 1;
					min-width: 100%;
				}
				.vapor-filters {
					order: 2;
					justify-content: space-between;
				}
				.vapor-filters select {
					flex: 1;
				}
				.vapor-actions {
					order: 3;
					justify-content: space-between;
				}
				.vapor-filter-row {
					order: 4;
				}
				.vapor-filter-row .vapor-duration {
					flex-direction: column;
					align-items: stretch;
					gap: 0.5rem;
				}
			}
			
			/* Flip Card Styles for Stream */
			.stream-flip-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				padding: 1rem 0;
			}
			.stream-flip-card {
				perspective: 1000px;
				cursor: pointer;
			}
			.stream-flip {
				position: relative;
				width: 100%;
				aspect-ratio: 1;
				transform-style: preserve-3d;
				transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
			}
			.stream-flip.flipped {
				transform: rotateY(180deg);
			}
			.stream-flip-front, .stream-flip-back {
				position: absolute;
				inset: 0;
				backface-visibility: hidden;
				border-radius: 12px;
				overflow: hidden;
			}
			.stream-flip-front {
				background: #1a1a1a;
			}
			.stream-flip-front img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.stream-flip-back {
				transform: rotateY(180deg);
				background: #0d0d0d;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 50%;
			}
			@keyframes vinylSpin { 
				from { transform: rotate(0deg); } 
				to { transform: rotate(360deg); } 
			}
			.stream-flip-vinyl {
				width: 90%;
				height: 90%;
				border-radius: 50%;
				position: relative;
				background: repeating-radial-gradient(circle at center, transparent 0px, transparent 3px, rgba(40,40,40,0.9) 3px, rgba(40,40,40,0.9) 4px),
					radial-gradient(circle at center, #1a1a1a 35%, #0a0a0a 100%);
				box-shadow: 0 0 30px rgba(0,0,0,0.5), inset 0 0 50px rgba(0,0,0,0.3);
			}
			.stream-playing .stream-flip-vinyl {
				animation: vinylSpin 1.8s linear infinite;
			}
			.stream-flip-vinyl::before {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 38%;
				height: 38%;
				border-radius: 50%;
				background: linear-gradient(135deg, #8b5cf6, #a78bfa);
				box-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
			}
			.stream-flip-vinyl::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				border-radius: 50%;
				background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%, transparent 100%);
			}
			.stream-flip-label {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 32%;
				height: 32%;
				border-radius: 50%;
				overflow: hidden;
			}
			.stream-flip-label img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.stream-flip-info {
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				padding: 1.5rem 1rem 1rem;
				background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
				color: #fff;
			}
			.stream-flip-title {
				font-weight: 700;
				font-size: 1rem;
				margin-bottom: 0.25rem;
				text-shadow: 0 2px 8px rgba(0,0,0,0.5);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.stream-flip-artist {
				font-size: 0.85rem;
				opacity: 0.85;
			}
			.stream-flip-stats {
				display: flex;
				gap: 0.5rem;
				margin-top: 0.5rem;
				flex-wrap: wrap;
			}
			.stream-flip-stats span {
				padding: 0.15rem 0.4rem;
				border-radius: 10px;
				font-size: 0.7rem;
				font-weight: 600;
				white-space: nowrap;
			}
			.stream-flip-genre {
				font-size: 0.7rem;
				margin-top: 0.4rem;
				opacity: 0.85;
				color: #c4b5fd;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-weight: 600;
			}
			.stat-plays { background: linear-gradient(135deg, #00d4ff, #06b6d4); color: #fff; }
			.stat-likes { background: linear-gradient(135deg, #ff6b9d, #ec4899); color: #fff; }
			.stat-reposts { background: linear-gradient(135deg, #a78bfa, #8b5cf6); color: #fff; }
			.stat-duration { background: linear-gradient(135deg, #fb923c, #f97316); color: #fff; }
			
			/* Playing indicator */
			@keyframes playingPulse {
				0%, 100% { box-shadow: 0 0 0 0 rgba(0, 212, 255, 0.4); }
				50% { box-shadow: 0 0 0 12px rgba(0, 212, 255, 0); }
			}
			.stream-flip-card.stream-playing .stream-flip-front {
				box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
				animation: playingPulse 2s ease-in-out infinite;
			}
			.stream-flip-card.stream-playing .stream-flip-front::after {
				content: '▶';
				position: absolute;
				top: 12px;
				right: 12px;
				width: 28px;
				height: 28px;
				background: linear-gradient(135deg, #00d4ff, #8b5cf6);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 12px;
				color: white;
				box-shadow: 0 2px 10px rgba(0, 212, 255, 0.5);
			}
		</style>

		<script>
			// Auto-sync on page load (non-blocking)
			(function() {
				const syncBtn = document.getElementById('sync-btn');
				if (syncBtn) {
					// Trigger background sync after page loads
					setTimeout(function() {
						fetch('/api/sync', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json'
							}
						}).then(function(response) {
							if (response.ok) {
								console.log('Background sync completed');
								// Refresh the track list
								htmx.trigger('#track-container', 'refresh');
							}
						}).catch(function(err) {
							console.log('Background sync failed:', err);
						});
					}, 500); // Wait 500ms after page load
				}
			})();

			// Sync tracks from SoundCloud (manual trigger)
			async function syncTracks() {
				const btn = document.getElementById('sync-btn');
				const originalText = btn.innerHTML;
				btn.innerHTML = '<span>Syncing...</span>';
				btn.disabled = true;
				
				const limit = document.getElementById('filter-limit')?.value || 50;
				
				try {
					const response = await fetch('/api/sync', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({ limit: parseInt(limit) * 2 })
					});
					
					if (response.ok) {
						const data = await response.json();
						btn.innerHTML = '<span>✅ Synced!</span>';
						setTimeout(() => {
							btn.innerHTML = originalText;
							btn.disabled = false;
						}, 2000);
						
						// Reload the track container
						htmx.trigger('#track-container', 'refresh');
						location.reload();
					} else {
						const error = await response.json();
						alert('Sync failed: ' + (error.error || 'Unknown error'));
						btn.innerHTML = originalText;
						btn.disabled = false;
					}
				} catch (err) {
					alert('Sync failed: ' + err.message);
					btn.innerHTML = originalText;
					btn.disabled = false;
				}
			}

			// Reset all filters to defaults
			function resetFilters() {
				// Reset search input
				const qInput = document.getElementById('filter-q');
				if (qInput) qInput.value = '';
				
				// Reset selects
				const contentType = document.getElementById('filter-content-type');
				if (contentType) contentType.value = '';
				
				const sort = document.getElementById('filter-sort');
				if (sort) sort.value = 'newest';
				
				const limit = document.getElementById('filter-limit');
				if (limit) limit.value = '20';
				
				// Reset duration slider
				const durationRange = document.getElementById('duration-range');
				if (durationRange) {
					durationRange.value = 0;
					const maxDur = parseInt(durationRange.max) || 94;
					const display = document.getElementById('duration-min-display');
					if (display) display.textContent = formatMinutes(0);
				}
				
				// Clear localStorage
				localStorage.removeItem('stream-filters');
				
				// Trigger HTMX refresh
				htmx.trigger('#track-container', 'refresh');
				
				// Optionally reload to get fresh data
				// location.reload();
			}

			// Save filter state to localStorage
			function saveFilterState() {
				const filters = {
					q: document.getElementById('filter-q')?.value || '',
					content_type: document.getElementById('filter-content-type')?.value || '',
					sort: document.getElementById('filter-sort')?.value || 'newest',
					limit: document.getElementById('filter-limit')?.value || '20',
					duration_min: document.getElementById('duration-range')?.value || '0'
				};
				localStorage.setItem('stream-filters', JSON.stringify(filters));
			}

			// Load filter state from localStorage
			function loadFilterState() {
				const saved = localStorage.getItem('stream-filters');
				if (!saved) return false;
				
				try {
					const filters = JSON.parse(saved);
					
					if (filters.q !== undefined) {
						const qInput = document.getElementById('filter-q');
						if (qInput) qInput.value = filters.q;
					}
					
					if (filters.content_type !== undefined) {
						const ctSelect = document.getElementById('filter-content-type');
						if (ctSelect) ctSelect.value = filters.content_type;
					}
					
					if (filters.sort !== undefined) {
						const sortSelect = document.getElementById('filter-sort');
						if (sortSelect) sortSelect.value = filters.sort;
					}
					
					if (filters.limit !== undefined) {
						const limitSelect = document.getElementById('filter-limit');
						if (limitSelect) limitSelect.value = filters.limit;
					}
					
					if (filters.duration_min !== undefined) {
						const durRange = document.getElementById('duration-range');
						if (durRange) {
							durRange.value = filters.duration_min;
							updateDurationDisplay(filters.duration_min);
						}
					}
					
					return true;
				} catch (e) {
					console.error('Failed to load filter state:', e);
					return false;
				}
			}

			// Setup event listeners to save filter state
			function setupFilterListeners() {
				// Listen to all filter inputs
				const qInput = document.getElementById('filter-q');
				const contentType = document.getElementById('filter-content-type');
				const sort = document.getElementById('filter-sort');
				const limit = document.getElementById('filter-limit');
				const durationRange = document.getElementById('duration-range');
				
				if (qInput) qInput.addEventListener('input', saveFilterState);
				if (contentType) contentType.addEventListener('change', saveFilterState);
				if (sort) sort.addEventListener('change', saveFilterState);
				if (limit) limit.addEventListener('change', saveFilterState);
				if (durationRange) durationRange.addEventListener('input', saveFilterState);
			}

			function formatMinutes(minutes) {
				const mins = parseInt(minutes);
				if (mins < 60) {
					return mins + ' min';
				}
				const hours = Math.floor(mins / 60);
				const remainingMins = mins % 60;
				if (remainingMins === 0) {
					return hours + ' hr';
				}
				return hours + ' hr ' + remainingMins + ' min';
			}

			function updateDurationDisplay(value) {
				const display = document.getElementById('duration-min-display');
				if (display) {
					display.textContent = formatMinutes(value);
				}
			}

			// Audio player functionality
			let currentAudio = null;
			let currentPlayerBar = null;

			document.addEventListener('click', function(e) {
				// Check for vcard play buttons (new style)
				const vcardBtn = e.target.closest('.vcard-play');
				if (vcardBtn) {
					const card = vcardBtn.closest('.vcard-3');
					if (!card) return;
					
					const trackID = card.dataset.trackId;
					const streamUrl = card.dataset.streamUrl || '';
					const titleEl = card.querySelector('.vcard-title');
					const title = titleEl ? titleEl.textContent : 'Unknown Track';
					const artistEl = card.querySelector('.vcard-artist');
					const artist = artistEl ? artistEl.textContent : 'Unknown Artist';
					const artworkEl = card.querySelector('.vcard-art');
					const artworkUrl = artworkEl ? artworkEl.src : '';
					
					console.log('Playing:', trackID, title, artist, streamUrl);
					
					// Remove existing player
					if (currentPlayerBar) {
						currentPlayerBar.remove();
					}
					if (currentAudio) {
						currentAudio.pause();
					}
					
					// Create player bar HTML
					const playerHtml = `
						<div class="player-bar" id="player-bar">
							<img src="${artworkUrl}" alt="" />
							<div class="player-bar-info">
								<div class="player-bar-title">${title}</div>
								<div class="player-bar-artist">${artist}</div>
							</div>
							<audio controls autoplay>
								<source src="/api/track/${trackID}/stream" type="audio/mpeg">
								Your browser does not support audio
							</audio>
							<button class="close-btn" onclick="this.parentElement.remove()">×</button>
						</div>
					`;
					
					const container = document.getElementById('player-container');
					if (container) {
						container.innerHTML = playerHtml;
						currentPlayerBar = container.querySelector('.player-bar');
						currentAudio = currentPlayerBar.querySelector('audio');
					}
					return;
				}
			
				// Check for track-card-pill-play buttons (old style)
				const btn = e.target.closest('.track-card-pill-play');
				if (!btn) return;

				const card = btn.closest('.track-card-pill');
				const artworkUrl = btn.style.backgroundImage.replace('url(', '').replace(')', '').replace(/"/g, '');
				const title = card.dataset.title || card.querySelector('.track-card-pill-title')?.textContent || 'Unknown Track';
				const artist = card.dataset.artist || card.querySelector('.track-card-pill-artist')?.textContent || 'Unknown Artist';
				const streamUrl = card.dataset.streamUrl || '';

				if (!streamUrl) {
					alert('Demo mode: Stream URL not available. Connect your SoundCloud account and sync to enable playback.');
					return;
				}

				// Remove existing player
				if (currentPlayerBar) {
					currentPlayerBar.remove();
				}
				if (currentAudio) {
					currentAudio.pause();
				}

				// Create player bar HTML
				const playerHtml = `
					<div class="player-bar" id="player-bar">
						<img src="${artworkUrl}" alt="" />
						<div class="player-bar-info">
							<div class="player-bar-title">${title}</div>
							<div class="player-bar-artist">${artist}</div>
						</div>
						<audio controls autoplay>
							<source src="${streamUrl}" type="audio/mpeg">
							Your browser does not support audio
						</audio>
						<button class="close-btn" onclick="this.parentElement.remove()">×</button>
					</div>
				`;

				document.getElementById('player-container').innerHTML = playerHtml;
				currentPlayerBar = document.getElementById('player-bar');
				currentAudio = currentPlayerBar.querySelector('audio');
			});

			// Handle load more with limit tracking
			function handleLoadMore(btn, event) {
				const limit = parseInt(document.getElementById('filter-limit')?.value) || 20;
				const currentLoaded = parseInt(btn.getAttribute('data-loaded')) || 0;
				const batchSize = 20;
				const newLoaded = currentLoaded + batchSize;
				
				btn.setAttribute('data-loaded', newLoaded);
				
				if (newLoaded >= limit) {
					btn.hidden = true;
					document.getElementById('no-more').hidden = false;
					return;
				}
				
				const currentPage = parseInt(btn.getAttribute('data-page'));
				btn.setAttribute('data-page', currentPage + 1);
				btn.setAttribute('hx-vals', JSON.stringify({page: currentPage + 1}));
			}

			// Reset load more button when filters change
			function resetLoadMoreButton() {
				const loadMoreBtn = document.getElementById('load-more-btn');
				const trackContainer = document.getElementById('track-container');
				const noMore = document.getElementById('no-more');
				
				if (loadMoreBtn && trackContainer) {
					const initialTracks = trackContainer.querySelectorAll('.track-card-pill').length;
					loadMoreBtn.setAttribute('data-loaded', initialTracks);
					loadMoreBtn.setAttribute('data-page', '2');
					loadMoreBtn.setAttribute('hx-vals', JSON.stringify({page: 2}));
					
					const limit = parseInt(document.getElementById('filter-limit')?.value) || 20;
					if (initialTracks >= limit) {
						loadMoreBtn.hidden = true;
						if (noMore) noMore.hidden = false;
					} else {
						loadMoreBtn.hidden = false;
						if (noMore) noMore.hidden = true;
					}
				}
			}

			// Initialize filter state on page load
			(function() {
				loadFilterState();
				setupFilterListeners();
				
				// Enhance all artwork to highest quality
				document.querySelectorAll('.stream-flip-card img').forEach(function(img) {
					img.src = upgradeArtwork(img.src);
				});
				
				// Initialize loaded count from initial tracks
				const loadMoreBtn = document.getElementById('load-more-btn');
				const trackContainer = document.getElementById('track-container');
				if (loadMoreBtn && trackContainer) {
					const initialTracks = trackContainer.querySelectorAll('.stream-flip-card, .track-card-pill').length;
					loadMoreBtn.setAttribute('data-loaded', initialTracks);
					
					const limit = parseInt(document.getElementById('filter-limit')?.value) || 20;
					if (initialTracks >= limit) {
						loadMoreBtn.hidden = true;
						document.getElementById('no-more').hidden = false;
					}
				}
			})();

			// Flip card handler for stream page
			let currentPlayingCard = null;

			function handleStreamFlip(card) {
				const flipEl = card.querySelector('.stream-flip');
				const isFlipped = flipEl.classList.toggle('flipped');
				
				// Remove playing class from previous card
				if (currentPlayingCard && currentPlayingCard !== card) {
					currentPlayingCard.classList.remove('stream-playing');
					currentPlayingCard.querySelector('.stream-flip').classList.remove('flipped');
				}
				
				if (isFlipped) {
					const trackID = card.dataset.trackId;
					const streamURL = card.dataset.streamUrl;
					const trackTitle = card.dataset.trackTitle;
					const artistName = card.dataset.artistName;
					
					console.log('Playing:', trackTitle, 'by', artistName);
					
					// Mark this card as playing
					card.classList.add('stream-playing');
					currentPlayingCard = card;
					
					// Get or create player
					let player = document.getElementById('stream-player-bar');
					if (!player) {
						player = document.createElement('div');
						player.id = 'stream-player-bar';
						player.className = 'player-bar';
						player.innerHTML = `
							<img id="stream-player-art" src="" alt="" style="width: 48px; height: 48px; border-radius: 4px; object-fit: cover;"/>
							<div class="player-bar-info">
								<div id="stream-player-title" class="player-bar-title"></div>
								<div id="stream-player-artist" class="player-bar-artist"></div>
							</div>
							<button class="player-btn" id="stream-player-play" style="background: #8b5cf6; border: none; color: white; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;">
								<svg id="stream-play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
								<svg id="stream-pause-icon" style="display:none" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
							</button>
							<div style="flex: 1; display: flex; flex-direction: column; gap: 4px;">
								<div class="player-bar" style="position: relative; height: 6px; background: rgba(255,255,255,0.2); border-radius: 3px; padding: 0; cursor: pointer;" id="stream-progress-bar">
									<div id="stream-progress-fill" style="height: 100%; background: linear-gradient(90deg, #8b5cf6, #a78bfa); border-radius: 3px; width: 0%;"></div>
								</div>
								<div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: rgba(255,255,255,0.6);">
									<span id="stream-current-time">0:00</span>
									<span id="stream-duration">0:00</span>
								</div>
							</div>
							<button class="close-btn" onclick="closeStreamPlayer()" style="background: none; border: none; color: #666; cursor: pointer; font-size: 1.25rem; padding: 0.25rem;">✕</button>
							<audio id="stream-audio" preload="none"></audio>
						`;
						document.body.appendChild(player);
						
						// Add event listeners
						document.getElementById('stream-player-play').addEventListener('click', toggleStreamPlay);
						document.getElementById('stream-progress-bar').addEventListener('click', seekStreamProgress);
						const audio = document.getElementById('stream-audio');
						audio.addEventListener('timeupdate', updateStreamProgress);
					}
					
					const playerArt = document.getElementById('stream-player-art');
					const playerTitle = document.getElementById('stream-player-title');
					const playerArtist = document.getElementById('stream-player-artist');
					const audio = document.getElementById('stream-audio');
					
					// Upgrade artwork to highest quality for player
					playerArt.src = upgradeArtwork(card.querySelector('img').src);
					playerTitle.textContent = trackTitle;
					playerArtist.textContent = artistName;
					audio.src = streamURL;
					audio.play().then(() => {
						document.getElementById('stream-play-icon').style.display = 'none';
						document.getElementById('stream-pause-icon').style.display = 'block';
					}).catch(err => console.error('Play error:', err));
				} else {
					const audio = document.getElementById('stream-audio');
					if (audio && !audio.paused) {
						audio.pause();
						document.getElementById('stream-play-icon').style.display = 'block';
						document.getElementById('stream-pause-icon').style.display = 'none';
					}
				}
			}

			function toggleStreamPlay() {
				const audio = document.getElementById('stream-audio');
				const playIcon = document.getElementById('stream-play-icon');
				const pauseIcon = document.getElementById('stream-pause-icon');
				if (audio.paused) {
					audio.play();
					playIcon.style.display = 'none';
					pauseIcon.style.display = 'block';
				} else {
					audio.pause();
					playIcon.style.display = 'block';
					pauseIcon.style.display = 'none';
				}
			}

			function seekStreamProgress(e) {
				const audio = document.getElementById('stream-audio');
				const bar = document.getElementById('stream-progress-bar');
				const rect = bar.getBoundingClientRect();
				const pos = (e.clientX - rect.left) / rect.width;
				audio.currentTime = pos * audio.duration;
			}

			function updateStreamProgress() {
				const audio = document.getElementById('stream-audio');
				const fill = document.getElementById('stream-progress-fill');
				const current = document.getElementById('stream-current-time');
				const duration = document.getElementById('stream-duration');
				if (audio.duration) {
					fill.style.width = (audio.currentTime / audio.duration * 100) + '%';
					current.textContent = formatStreamTime(audio.currentTime);
					duration.textContent = formatStreamTime(audio.duration);
				}
			}

			function formatStreamTime(seconds) {
				if (!seconds || isNaN(seconds)) return '0:00';
				const mins = Math.floor(seconds / 60);
				const secs = Math.floor(seconds % 60);
				return mins + ':' + secs.toString().padStart(2, '0');
			}

			function closeStreamPlayer() {
				const player = document.getElementById('stream-player-bar');
				const audio = document.getElementById('stream-audio');
				if (player) {
					audio.pause();
					player.remove();
				}
			}

			function formatCompact(num) {
				if (!num) return '0';
				if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
				if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
				return num.toString();
			}

			function formatDuration(ms) {
				if (!ms) return '0:00';
				const totalSeconds = Math.floor(ms / 1000);
				const mins = Math.floor(totalSeconds / 60);
				const secs = totalSeconds % 60;
				return mins + ':' + secs.toString().padStart(2, '0');
			}

			// Upgrade artwork to highest quality
			function upgradeArtwork(url) {
				if (!url) return url;
				// Replace any small size with largest available (t500x500)
				return url.replace(/-t\d+x\d+/g, '-t500x500').replace('-large.', '-t500x500.');
			}
		</script>
	}
}
