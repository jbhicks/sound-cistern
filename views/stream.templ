package views

import "github.com/jbhicks/sound-cistern/views/components"

type StreamData struct {
	PageData
	Tracks []Track
}

templ Stream(data StreamData) {
	@Layout(data.PageData) {
		<!-- Page header section with semantic h1 -->
		<section class="page-header" aria-labelledby="stream-title">
			<hgroup>
				<h1 id="stream-title" class="page-title">Your Stream</h1>
				<p class="page-description">Chronological feed of your Soundcloud tracks</p>
			</hgroup>
		</section>
		
		<!-- Filter bar with semantic form and proper ARIA labels -->
		<section class="filter-section" aria-label="Track filters">
			<form 
				class="filter-form" 
				id="filter-form"
				role="search"
				aria-label="Filter tracks"
				hx-get="/api/search"
				hx-target="#track-container"
				hx-swap="innerHTML"
				hx-indicator="#loading-indicator"
				hx-trigger="change from:select, input delay:300ms from:input[type='search']"
			>
				<div class="filter-group filter-group--search">
					<label for="search-input" class="filter-label">
						<span class="filter-label-text">Search</span>
					</label>
					<div class="search-input-wrapper">
						<input 
							type="search" 
							id="search-input"
							name="q"
							class="filter-input filter-input--search"
							placeholder="Search tracks, artists, or genres..."
							aria-describedby="search-help"
							autocomplete="off"
						/>
						<span class="search-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.35-4.35"></path>
							</svg>
						</span>
					</div>
					<span id="search-help" class="filter-help">Type to filter your tracks</span>
				</div>
				
				<div class="filter-group">
					<label for="genre-filter" class="filter-label">
						<span class="filter-label-text">Genre</span>
					</label>
					<select 
						id="genre-filter"
						name="genre"
						class="filter-input filter-input--select"
						aria-label="Filter by genre"
					>
						<option value="">All Genres</option>
						<option value="electronic">Electronic</option>
						<option value="hip-hop">Hip Hop</option>
						<option value="rock">Rock</option>
						<option value="pop">Pop</option>
						<option value="jazz">Jazz</option>
						<option value="classical">Classical</option>
						<option value="ambient">Ambient</option>
						<option value="experimental">Experimental</option>
					</select>
				</div>
				
				<div class="filter-group">
					<label for="sort-filter" class="filter-label">
						<span class="filter-label-text">Sort</span>
					</label>
					<select 
						id="sort-filter"
						name="sort"
						class="filter-input filter-input--select"
						aria-label="Sort tracks"
					>
						<option value="newest">Newest First</option>
						<option value="oldest">Oldest First</option>
						<option value="title">Title A-Z</option>
						<option value="artist">Artist A-Z</option>
						<option value="duration">Duration</option>
					</select>
				</div>
				
				<div class="filter-actions">
					<button 
						type="button"
						class="btn btn-secondary filter-clear-btn"
						onclick="clearFilters()"
						aria-label="Clear all filters"
					>
						<span class="btn-icon" aria-hidden="true">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M18 6 6 18"></path>
								<path d="m6 6 12 12"></path>
							</svg>
						</span>
						<span class="btn-text">Clear</span>
					</button>
				</div>
			</form>
			
			<!-- Active filter indicator -->
			<div id="active-filters" class="active-filters" aria-live="polite" aria-atomic="true"></div>
		</section>
		
		<!-- Main track container with loading and empty states -->
		<section class="tracks-section" aria-label="Track results">
			<!-- Loading indicator with ARIA live region -->
			<div 
				id="loading-indicator" 
				class="loading-indicator"
				role="status"
				aria-live="polite"
				aria-busy="true"
			>
				<div class="loading-spinner" aria-hidden="true">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="10">
							<animateTransform
								attributeName="transform"
								attributeType="XML"
								type="rotate"
								from="0 12 12"
								to="360 12 12"
								dur="1s"
								repeatCount="indefinite"
							/>
						</circle>
					</svg>
				</div>
				<span class="loading-text">Loading tracks...</span>
			</div>
			
			<!-- Track list container -->
			<div id="track-container" class="track-container">
				if len(data.Tracks) > 0 {
					<ul class="track-list" role="list" aria-label="List of tracks">
						for _, track := range data.Tracks {
							<li role="listitem">
								@components.TrackCard(
									track.TrackID,
									track.TrackTitle,
									track.ArtistName,
									track.TrackDuration,
									track.ArtworkURL,
									track.PermalinkURL,
									track.CreatedAt.Format("Jan 2, 2006"),
									track.IsFavorited,
								)
							</li>
						}
					</ul>
				} else {
					<!-- Empty state - shown when no tracks are available -->
					@components.EmptyState(
						"No tracks found",
						"Connect your Soundcloud account to start aggregating your favorite tracks.",
						"Connect Soundcloud",
						"/dashboard",
					)
				}
			</div>
			
			<!-- Pagination / Load more section -->
			<div class="load-more-section" id="load-more-section">
				<button 
					type="button"
					class="btn btn-secondary load-more-btn"
					id="load-more-btn"
					data-page="2"
					hx-get="/api/stream?page=2"
					hx-target="#track-container"
					hx-swap="beforeend"
					hx-indicator="#load-more-indicator"
					hx-push-url="false"
					hx-on::before-request="this.disabled = true; this.setAttribute('aria-busy', 'true');"
					hx-on::after-request="handleLoadMoreComplete(this, event.detail.successful, event.detail.xhr)"
					aria-label="Load more tracks"
				>
					<span class="btn-text">Load More Tracks</span>
					<span class="btn-loading" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="10">
								<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
							</circle>
						</svg>
					</span>
				</button>
				<div 
					id="load-more-indicator" 
					class="load-more-indicator"
					role="status"
					aria-live="polite"
					aria-busy="true"
				>
					<span class="loading-spinner-small" aria-hidden="true"></span>
					<span>Loading more tracks...</span>
				</div>
				<div 
					id="no-more-results" 
					class="no-more-results"
					role="status"
					aria-live="polite"
					style="display: none;"
				>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
					</svg>
					<span>All tracks loaded</span>
				</div>
			</div>
		</section>
		
		<!-- JavaScript for enhanced interactivity -->
		<script>
			// Pass logged-in status from template
			window.isLoggedIn = { data.User != nil ? "true" : "false" };
			
			/**
			 * Clear all filter inputs and reload tracks
			 */
			function clearFilters() {
				const form = document.getElementById('filter-form');
				const inputs = form.querySelectorAll('input, select');
				
				inputs.forEach(input => {
					if (input.type === 'search') {
						input.value = '';
					} else if (input.tagName === 'SELECT') {
						input.selectedIndex = 0;
					}
				});
				
				// Update ARIA live region to announce filter reset
				const activeFilters = document.getElementById('active-filters');
				if (activeFilters) {
					activeFilters.textContent = 'Filters cleared';
					setTimeout(() => {
						activeFilters.textContent = '';
					}, 2000);
				}
				
				// Trigger HTMX request to reload with no filters
				htmx.trigger(form, 'change');
			}
			
			/**
			 * Toggle favorite status for a track with loading states and error handling
			 * @param {HTMLButtonElement} button - The favorite button element
			 */
			function toggleFavorite(button) {
				const trackId = button.dataset.trackId;
				const trackTitle = button.dataset.trackTitle || 'track';
				const isFavorited = button.getAttribute('aria-pressed') === 'true';
				const newState = !isFavorited;
				
				// Prevent double-clicks
				if (button.disabled) return;
				
				// Show loading state
				button.disabled = true;
				button.setAttribute('aria-busy', 'true');
				button.classList.add('loading');
				
				// Make API request
				fetch('/api/favorites/' + trackId + '/toggle', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'X-Requested-With': 'XMLHttpRequest'
					}
				})
				.then(response => {
					if (!response.ok) {
						throw new Error('Failed to toggle favorite');
					}
					return response.json();
				})
				.then(data => {
					// Update UI on success
					button.classList.toggle('favorited', newState);
					button.setAttribute('aria-pressed', newState ? 'true' : 'false');
					button.setAttribute('aria-label', newState ? 
						`Remove ${trackTitle} from favorites` : 
						`Add ${trackTitle} to favorites`
					);
					
					// Update button text
					const btnText = button.querySelector('.btn-text');
					if (btnText) {
						btnText.textContent = newState ? 'Favorited' : 'Favorite';
					}
					
					// Update icon
					const icon = button.querySelector('.favorite-icon');
					if (icon) {
						icon.innerHTML = newState ? 
							'<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>' :
							'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>';
					}
					
					// Announce to screen readers
					const announcement = document.createElement('div');
					announcement.setAttribute('role', 'status');
					announcement.setAttribute('aria-live', 'polite');
					announcement.className = 'sr-only';
					announcement.textContent = newState ? 
						`${trackTitle} added to favorites` : 
						`${trackTitle} removed from favorites`;
					document.body.appendChild(announcement);
					setTimeout(() => announcement.remove(), 1000);
				})
				.catch(error => {
					console.error('Error toggling favorite:', error);
					// Show error notification
					if (typeof showErrorNotification === 'function') {
						showErrorNotification('Failed to update favorite. Please try again.');
					}
				})
				.finally(() => {
					// Remove loading state
					button.disabled = false;
					button.removeAttribute('aria-busy');
					button.classList.remove('loading');
				});
			}
			
			/**
			 * Format duration from milliseconds to MM:SS
			 * @param {number} ms - Duration in milliseconds
			 * @returns {string} Formatted duration
			 */
			function formatDuration(ms) {
				const seconds = Math.floor(ms / 1000);
				const minutes = Math.floor(seconds / 60);
				const remainingSeconds = seconds % 60;
				return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
			}
			
			/**
			 * Update active filters display
			 */
			function updateActiveFilters() {
				const form = document.getElementById('filter-form');
				const searchValue = form.querySelector('[name="q"]').value;
				const genreValue = form.querySelector('[name="genre"]').value;
				const sortValue = form.querySelector('[name="sort"]').value;
				const activeFilters = document.getElementById('active-filters');
				
				const filters = [];
				if (searchValue) filters.push(`Search: "${searchValue}"`);
				if (genreValue) filters.push(`Genre: ${genreValue}`);
				if (sortValue && sortValue !== 'newest') {
					const sortLabels = {
						'oldest': 'Oldest First',
						'title': 'Title A-Z',
						'artist': 'Artist A-Z',
						'duration': 'Duration'
					};
					filters.push(`Sort: ${sortLabels[sortValue] || sortValue}`);
				}
				
				if (filters.length > 0) {
					activeFilters.innerHTML = '<span class="active-filters-label">Active filters:</span> ' + 
						filters.map(f => `<span class="filter-tag">${f}</span>`).join(' ');
				} else {
					activeFilters.innerHTML = '';
				}
				
				// Announce filter changes to screen readers
				const announcement = document.createElement('div');
				announcement.setAttribute('role', 'status');
				announcement.setAttribute('aria-live', 'polite');
				announcement.className = 'sr-only';
				announcement.textContent = filters.length > 0 ? 
					`Filters applied: ${filters.join(', ')}` : 
					'All filters cleared';
				document.body.appendChild(announcement);
				setTimeout(() => announcement.remove(), 1000);
			}
			
			/**
			 * Handle load more button completion
			 * @param {HTMLButtonElement} button - The load more button
			 * @param {boolean} successful - Whether the request was successful
			 * @param {XMLHttpRequest} xhr - The XHR object
			 */
			function handleLoadMoreComplete(button, successful, xhr) {
				button.disabled = false;
				button.removeAttribute('aria-busy');
				
				if (successful) {
					// Check if response contains tracks
					const response = xhr.response;
					if (!response || response.trim() === '') {
						// No more results
						button.style.display = 'none';
						const noMoreMsg = document.getElementById('no-more-results');
						if (noMoreMsg) {
							noMoreMsg.style.display = 'flex';
						}
					} else {
						// Update page number for next load
						const currentPage = parseInt(button.dataset.page || '2');
						const nextPage = currentPage + 1;
						button.dataset.page = nextPage;
						button.setAttribute('hx-get', '/api/stream?page=' + nextPage);
						
						// Announce to screen readers
						const announcement = document.createElement('div');
						announcement.setAttribute('role', 'status');
						announcement.setAttribute('aria-live', 'polite');
						announcement.className = 'sr-only';
						announcement.textContent = 'More tracks loaded';
						document.body.appendChild(announcement);
						setTimeout(() => announcement.remove(), 1000);
					}
				} else {
					// Error occurred
					button.classList.add('error');
					setTimeout(() => button.classList.remove('error'), 3000);
				}
			}
			
			// Initialize on DOM ready
			document.addEventListener('DOMContentLoaded', function() {
				// Update active filters when form inputs change
				const form = document.getElementById('filter-form');
				if (form) {
					form.addEventListener('input', updateActiveFilters);
					form.addEventListener('change', updateActiveFilters);
				}
				
				// Add HTMX event listeners for filter results
				document.body.addEventListener('htmx:afterRequest', function(evt) {
					if (evt.detail.target.id === 'track-container') {
						updateActiveFilters();
						
						// Re-attach event listeners to new content
						const favoriteButtons = document.querySelectorAll('.favorite-btn');
						favoriteButtons.forEach(btn => {
							btn.onclick = function() { toggleFavorite(this); };
						});
					}
				});
				
				// Load initial tracks if user is logged in and no tracks provided
				if (window.isLoggedIn === 'true' && !document.querySelector('.track-list')) {
					// Trigger initial load
					const form = document.getElementById('filter-form');
					if (form) {
						htmx.trigger(form, 'submit');
					}
				}
			});
		</script>
		
		<style>
			/* Page header styles */
			.page-header {
				margin-bottom: var(--space-6);
				padding-bottom: var(--space-4);
				border-bottom: 1px solid var(--color-border-default);
			}
			
			.page-title {
				font-size: var(--text-3xl);
				font-weight: var(--font-semibold);
				color: var(--color-fg-default);
				margin: 0 0 var(--space-2) 0;
				line-height: var(--lh-tight);
			}
			
			.page-description {
				font-size: var(--text-lg);
				color: var(--color-fg-muted);
				margin: 0;
			}
			
			/* Filter section styles */
			.filter-section {
				background: var(--color-canvas-subtle);
				border: 1px solid var(--color-border-default);
				border-radius: var(--radius-lg);
				padding: var(--space-4);
				margin-bottom: var(--space-6);
			}
			
			.filter-form {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-4);
				align-items: flex-end;
			}
			
			.filter-group {
				display: flex;
				flex-direction: column;
				gap: var(--space-1);
			}
			
			.filter-group--search {
				flex: 1;
				min-width: 250px;
			}
			
			.filter-label {
				font-size: var(--text-sm);
				font-weight: var(--font-medium);
				color: var(--color-fg-default);
			}
			
			.filter-label-text {
				display: block;
				margin-bottom: var(--space-1);
			}
			
			.filter-input {
				padding: var(--space-2) var(--space-3);
				font-size: var(--text-sm);
				color: var(--color-fg-default);
				background: var(--color-canvas-default);
				border: 1px solid var(--color-border-default);
				border-radius: var(--radius-md);
				transition: border-color var(--duration-fast) var(--ease-out),
							box-shadow var(--duration-fast) var(--ease-out);
				min-height: 44px;
			}
			
			.filter-input:focus {
				outline: none;
				border-color: var(--color-accent-fg);
				box-shadow: 0 0 0 3px var(--color-accent-muted);
			}
			
			.filter-input--search {
				padding-left: var(--space-8);
			}
			
			.search-input-wrapper {
				position: relative;
			}
			
			.search-icon {
				position: absolute;
				left: var(--space-3);
				top: 50%;
				transform: translateY(-50%);
				color: var(--color-fg-muted);
				pointer-events: none;
			}
			
			.filter-help {
				font-size: var(--text-xs);
				color: var(--color-fg-muted);
				margin-top: var(--space-1);
			}
			
			.filter-actions {
				display: flex;
				align-items: flex-end;
			}
			
			.filter-clear-btn {
				display: inline-flex;
				align-items: center;
				gap: var(--space-2);
			}
			
			/* Active filters display */
			.active-filters {
				margin-top: var(--space-3);
				font-size: var(--text-sm);
			}
			
			.active-filters-label {
				color: var(--color-fg-muted);
				margin-right: var(--space-2);
			}
			
			.filter-tag {
				display: inline-flex;
				align-items: center;
				padding: var(--space-1) var(--space-2);
				background: var(--color-accent-muted);
				color: var(--color-accent-fg);
				border-radius: var(--radius-md);
				font-size: var(--text-xs);
				margin-right: var(--space-2);
			}
			
			/* Loading states */
			.loading-indicator {
				display: none;
				text-align: center;
				padding: var(--space-8);
				color: var(--color-fg-muted);
			}
			
			.loading-indicator.htmx-request {
				display: block;
			}
			
			.loading-text {
				margin-top: var(--space-3);
				display: block;
			}
			
			/* Tracks section */
			.tracks-section {
				min-height: 300px;
			}
			
			.track-container {
				min-height: 200px;
			}
			
			/* Load more section */
			.load-more-section {
				text-align: center;
				margin-top: var(--space-8);
				padding: var(--space-4) 0;
			}
			
			.load-more-btn {
				min-width: 200px;
				position: relative;
			}
			
			.load-more-btn:disabled {
				opacity: 0.7;
				cursor: wait;
			}
			
			.load-more-btn .btn-loading {
				display: none;
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
			}
			
			.load-more-btn[aria-busy="true"] .btn-text {
				opacity: 0;
			}
			
			.load-more-btn[aria-busy="true"] .btn-loading {
				display: inline-flex;
			}
			
			.load-more-btn.error {
				animation: shake 0.5s ease-in-out;
				border-color: var(--color-danger-fg);
			}
			
			@keyframes shake {
				0%, 100% { transform: translateX(0); }
				25% { transform: translateX(-5px); }
				75% { transform: translateX(5px); }
			}
			
			.load-more-indicator {
				display: none;
				color: var(--color-fg-muted);
				margin-top: var(--space-3);
				align-items: center;
				justify-content: center;
				gap: var(--space-2);
			}
			
			.load-more-indicator.htmx-request {
				display: flex;
			}
			
			.no-more-results {
				color: var(--color-success-fg);
				margin-top: var(--space-3);
				align-items: center;
				justify-content: center;
				gap: var(--space-2);
				font-size: var(--text-sm);
			}
			
			/* Responsive adjustments */
			@media (max-width: 768px) {
				.filter-form {
					flex-direction: column;
					gap: var(--space-3);
				}
				
				.filter-group {
					width: 100%;
				}
				
				.filter-group--search {
					min-width: 100%;
				}
				
				.filter-input {
					width: 100%;
				}
				
				.page-title {
					font-size: var(--text-2xl);
				}
				
				.page-description {
					font-size: var(--text-base);
				}
			}
		</style>
	}
}