					<div class="card-44-stats">
						<div class="card-44-stat">
							<div class="card-44-value">{ formatCount(data.Track.PlaybackCount) }</div>
							<div class="card-44-label">PLAYS</div>
						</div>
						<div class="card-44-stat">
							<div class="card-44-value">{ formatCount(data.Track.FavoritingsCount) }</div>
							<div class="card-44-label">LIKES</div>
						</div>
						<div class="card-44-stat">
							<div class="card-44-value">{ formatDuration(data.Track.TrackDuration) }</div>
