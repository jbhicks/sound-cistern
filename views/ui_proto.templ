					</div>
				</div>

				<!-- Card 41: Folded Corner -->
				<div class="proto-item">
					<div class="proto-label">41. Folded Corner</div>
					<div class="card-41">
						<strong>{ data.Track.TrackTitle }</strong>
						<br/>
						<small>{ data.Track.ArtistName }</small>
					</div>
				</div>

				<!-- Card 42: Highlight Bar -->
				<div class="proto-item">
					<div class="proto-label">42. Highlight Bar</div>
					<div class="card-42">
						<strong>{ data.Track.TrackTitle }</strong>
						<br/>
						<small>{ data.Track.ArtistName }</small>
					</div>
				</div>

				<!-- Card 43: Tag Cloud -->
				<div class="proto-item">
					<div class="proto-label">43. Tag Cloud</div>
