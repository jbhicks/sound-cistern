						<br/>
						<small>{ data.Track.ArtistName }</small>
					</div>
				</div>

				<!-- Card 47: Compact Badge -->
				<div class="proto-item">
					<div class="proto-label">47. Compact Badge</div>
					<div class="card-47">
						<strong>{ data.Track.TrackTitle }</strong>
						<small> • { data.Track.ArtistName }</small>
					</div>
				</div>

				<!-- Card 48: Expandable Hint -->
				<div class="proto-item">
					<div class="proto-label">48. Expandable Hint</div>
					<div class="card-48">
						<strong>{ data.Track.TrackTitle }</strong>
						<br/>
						<small>{ data.Track.ArtistName }</small>
					</div>
				</div>

				<!-- Card 49: Status Dot -->
				<div class="proto-item">
					<div class="proto-label">49. Status Dot</div>
