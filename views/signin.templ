package views

templ SignIn(data PageData) {
	@Layout(data) {
		<main class="auth-container" role="main" aria-label="Sign in page">
			<article class="auth-card">
				<header class="auth-card__header">
					<div class="auth-icon auth-icon--primary" aria-hidden="true">
						<svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
						</svg>
					</div>
					<h1 class="auth-card__title">Sign in</h1>
					<p class="auth-card__subtitle">Connect your Soundcloud account to access your audio feeds</p>
				</header>
				
				<section class="auth-card__body">
					<!-- OAuth Explanation -->
					<div class="auth-info-box" role="note">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<p>We use Soundcloud's secure OAuth authentication. You'll be redirected to Soundcloud to authorize access.</p>
					</div>
					
					<!-- Error State (shown conditionally via HTMX or server-side) -->
					<div id="auth-error" class="auth-error" role="alert" aria-live="polite" style="display: none;">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<circle cx="12" cy="12" r="10"/>
							<path d="M12 8v4M12 16h.01"/>
						</svg>
						<span class="auth-error__message">Authentication failed. Please try again.</span>
					</div>
					
					<!-- OAuth Button as Semantic Form -->
					<form class="auth-form auth-form--oauth" action="/auth/soundcloud" method="GET" aria-label="Soundcloud authentication">
						<button 
							type="submit" 
							class="soundcloud-btn soundcloud-btn--full"
							aria-label="Continue with Soundcloud"
							hx-indicator="#oauth-loading-signin"
						>
							<svg class="soundcloud-btn__icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
							</svg>
							<span class="soundcloud-btn__text">Continue with Soundcloud</span>
							<span id="oauth-loading-signin" class="htmx-indicator soundcloud-btn__spinner" aria-hidden="true">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 2v4m0 12v4M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83" opacity="0.3"/>
									<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
								</svg>
							</span>
						</button>
					</form>
				</section>
				
				<footer class="auth-card__footer">
					<p class="auth-footer-text">
						Don't have an account? 
						<a href="/signup" class="auth-link">Create one</a>
					</p>
				</footer>
			</article>
		</main>
	}
}
