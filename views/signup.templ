package views

templ SignUp(data PageData) {
	@Layout(data) {
		<main class="auth-container" role="main" aria-label="Sign up page">
			<article class="auth-card">
				<header class="auth-card__header">
					<div class="auth-icon auth-icon--primary" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
							<circle cx="9" cy="7" r="4"/>
							<path d="m22 21-3-3 3-3"/>
						</svg>
					</div>
					<h1 class="auth-card__title">Create your account</h1>
					<p class="auth-card__subtitle">Join Sound Cistern to manage your audio feeds</p>
				</header>
				
				<section class="auth-card__body">
					<!-- Error State Container -->
					<div id="signup-error" class="auth-error" role="alert" aria-live="assertive" style="display: none;">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<circle cx="12" cy="12" r="10"/>
							<path d="M12 8v4M12 16h.01"/>
						</svg>
						<span class="auth-error__message">Please fix the errors below and try again.</span>
					</div>
					
					<form 
						class="auth-form" 
						method="POST" 
						action="/api/collections/users/records"
						aria-label="Account creation form"
						hx-post="/api/collections/users/records"
						hx-target="#signup-error"
						hx-swap="outerHTML"
					>
						<fieldset class="auth-fieldset">
							<legend class="sr-only">Personal Information</legend>
							
							<div class="auth-form-group">
								<label for="first_name" class="auth-label">
									First Name
									<span class="auth-required" aria-hidden="true">*</span>
								</label>
								<input 
									type="text" 
									id="first_name"
									name="first_name" 
									required 
									placeholder="Enter your first name"
									class="auth-input"
									aria-required="true"
									aria-describedby="first_name-help"
								>
								<span id="first_name-help" class="auth-help-text sr-only">Your first name is required</span>
							</div>
							
							<div class="auth-form-group">
								<label for="last_name" class="auth-label">
									Last Name
									<span class="auth-required" aria-hidden="true">*</span>
								</label>
								<input 
									type="text" 
									id="last_name"
									name="last_name" 
									required 
									placeholder="Enter your last name"
									class="auth-input"
									aria-required="true"
									aria-describedby="last_name-help"
								>
								<span id="last_name-help" class="auth-help-text sr-only">Your last name is required</span>
							</div>
							
							<div class="auth-form-group">
								<label for="email" class="auth-label">
									Email
									<span class="auth-required" aria-hidden="true">*</span>
								</label>
								<input 
									type="email" 
									id="email"
									name="email" 
									required 
									placeholder="Enter your email address"
									class="auth-input"
									aria-required="true"
									aria-describedby="email-help"
								>
								<span id="email-help" class="auth-help-text sr-only">A valid email address is required</span>
							</div>
							
							<div class="auth-form-group">
								<label for="password" class="auth-label">
									Password
									<span class="auth-required" aria-hidden="true">*</span>
								</label>
								<input 
									type="password" 
									id="password"
									name="password" 
									required 
									placeholder="Create a password"
									class="auth-input"
									aria-required="true"
									aria-describedby="password-help"
									minlength="8"
								>
								<span id="password-help" class="auth-help-text">Must be at least 8 characters</span>
							</div>
							
							<div class="auth-form-group">
								<label for="passwordConfirm" class="auth-label">
									Confirm Password
									<span class="auth-required" aria-hidden="true">*</span>
								</label>
								<input 
									type="password" 
									id="passwordConfirm"
									name="passwordConfirm" 
									required 
									placeholder="Confirm your password"
									class="auth-input"
									aria-required="true"
									aria-describedby="passwordConfirm-help"
								>
								<span id="passwordConfirm-help" class="auth-help-text sr-only">Please re-enter your password to confirm</span>
							</div>
							
							<div class="auth-form-group auth-form-group--checkbox">
								<label for="accept-terms" class="auth-checkbox-label">
									<input 
										type="checkbox" 
										id="accept-terms"
										name="accept-terms" 
										required
										class="auth-checkbox"
										aria-required="true"
										aria-describedby="terms-help"
									>
									<span class="auth-checkbox-text">
										I agree to the <a href="#" class="auth-link">Terms of Service</a> and <a href="#" class="auth-link">Privacy Policy</a>
									</span>
								</label>
								<span id="terms-help" class="auth-help-text sr-only">You must accept the terms to continue</span>
							</div>
						</fieldset>
						
						<button 
							type="submit" 
							class="auth-submit-btn"
							hx-indicator="#signup-loading"
						>
							<span class="auth-submit-btn__text">Create Account</span>
							<span id="signup-loading" class="htmx-indicator auth-submit-btn__spinner" aria-hidden="true">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 2v4m0 12v4M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83" opacity="0.3"/>
									<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
								</svg>
							</span>
						</button>
					</form>
					
					<!-- OAuth Alternative -->
					<section class="auth-oauth-section" aria-labelledby="oauth-heading">
						<h2 id="oauth-heading" class="auth-divider">
							<span>Or sign up with</span>
						</h2>
						
						<div class="auth-oauth-buttons">
							<a 
								href="/auth/soundcloud" 
								role="button" 
								class="soundcloud-btn soundcloud-btn--secondary"
								aria-label="Sign up with Soundcloud"
							>
								<svg class="soundcloud-btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
								</svg>
								<span class="soundcloud-btn__text">Soundcloud</span>
							</a>
						</div>
					</section>
				</section>
				
				<footer class="auth-card__footer">
					<p class="auth-footer-text">
						Already have an account? 
						<a href="/signin" class="auth-link">Sign in instead</a>
					</p>
				</footer>
			</article>
		</main>
	}
}
