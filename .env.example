# Sound Cistern Environment Configuration

# Soundcloud API Configuration
# Get these from https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret_here
SOUNDCLOUD_REDIRECT_URI=http://localhost:8090/auth/callback

# Application Environment
GO_ENV=development

# Optional: Custom logging level
# LOG_LEVEL=info